{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug organization-service (serverless offline)",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--inspect=9232",
        "${workspaceFolder}/node_modules/serverless/bin/serverless.js",
        "offline",
        "--stage",
        "dev"
      ],
      "cwd": "${workspaceFolder}/apps/organization-service",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**", "node_modules/**"],
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/apps/organization-service/.esbuild/**/*.js",
        "${workspaceFolder}/apps/organization-service/dist/**/*.js",
        "${workspaceFolder}/**/dist/**/*.js",
        "!**/node_modules/**"
      ]
    },
