# For local `npm run dev`, defaults are in `.env.development` (committed).
# Copy this file to `.env.local` only if you need overrides.
#
# -----------------------------------------------------------------------------
# api-aggregator-registry (API Gateway HTTP API) — deployed routes:
#   GET  /health
#   GET  /services
#   POST /services
#   GET  /specs
#   GET  /specs/{service}   (optional ?version=v1)
# -----------------------------------------------------------------------------
# Point the UI at your deployed API (no trailing slash). Example from deploy:
VITE_API_BASE_URL=https://mgkys4bnl4.execute-api.us-east-1.amazonaws.com

# Or run without this file: `pnpm dev:registry` (same URL baked into package.json).
# Comment out the line above to use the Vite dev proxy instead:
#   /api -> http://localhost:4000 (Express aggregator in /backend)
