{
  "name": "@api-hub/alert-service-e2e",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "alert-service-e2e",
    "implicitDependencies": [
      "alert-service"
    ],
    "targets": {
      "e2e": {
        "executor": "@nx/jest:jest",
        "outputs": [
          "{projectRoot}/test-output/jest/coverage"
        ],
        "options": {
          "jestConfig": "apps/alert-service-e2e/jest.config.cts",
          "passWithNoTests": true
        },
        "dependsOn": ["alert-service:build"]
      }
    }
  }
}
