<p local-id=3D"48e51f82a360">PK + GSIs only</p></td>
</tr>
<tr data-local-id=3D"36d9ac96-baad-4d9b-b71e-17f8eb3aac32">
<td data-local-id=3D"716d1b6f-291a-45dc-8a54-d7431f5a8d99" class=3D"conflue=
nceTd">
<p local-id=3D"3a19fac58c14">Writes</p></td>
<td data-local-id=3D"fcec455d-235b-4888-82b0-c805804d633c" class=3D"conflue=
nceTd">
