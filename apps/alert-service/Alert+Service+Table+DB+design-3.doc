    <h1>Alert Service Table DB design</h1>
    <div class=3D"Section1">
        <p local-id=3D"095c8e5bb40b">Alert table must cover all these</p>
<ol start=3D"1" local-id=3D"af4ebe1e372c">
<li local-id=3D"38cb1271-7807-4e6a-8058-937f4c38085a">
<p local-id=3D"feef1b3ae8aa">Alert lifecycle</p></li>
<li local-id=3D"533d3995-14b3-41af-bb01-e0903394795c">
<p local-id=3D"b21a689ab82a">Assignment</p></li>
<li local-id=3D"09f22ea9-013d-44fd-a3f9-f5d09b1e3870">
<p local-id=3D"8544daefbfd2">Grouping</p></li>
<li local-id=3D"ceb5a8ca-5398-4a8e-81aa-c8c116076d2a">
<p local-id=3D"3a463979ed5c">SLA</p></li>
<li local-id=3D"8e34fa3c-f84d-44ec-bfe7-e71d2f859e2e">
<p local-id=3D"b5469abedbd3">History/Audit</p></li>
<li local-id=3D"44bf2396-0dc0-4849-8e5c-4d0ab378ce19">
<p local-id=3D"4af05f56aa81">Operational reporting</p></li>
</ol>
