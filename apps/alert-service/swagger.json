{
  "swagger": "2.0",
  "info": {
    "title": "Alert Service API",
    "version": "1.0.0",
    "description": "Alerts: HTTP APIs. **Deployed Swagger UI uses this file + serverless-auto-swagger** — it does not load `docs/services/alert-service/api/open-api.yaml`. Rich multi-example narratives live there; this spec carries **Swagger 2–compatible `example` / `x-example`** values for Try-it-out and model panels."
  },
  "schemes": ["https", "http"],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "securityDefinitions": {
    "bearerAuth": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "Bearer JWT from the identity provider."
    }
  },
  "definitions": {
    "InputType": {
      "type": "string",
      "enum": [
        "THRESHOLD_BREACH",
        "MISSED_READING",
        "MISSING_DEVICE",
        "SYMPTOM_RISK_TRIGGER",
        "ENGAGEMENT_TRIGGER"
      ]
    },
    "CreateAlertInputType": {
      "type": "string",
      "description": "POST /alerts only — §5.1.3.1 (MISSED_READING | MISSING_DEVICE).",
      "enum": ["MISSED_READING", "MISSING_DEVICE"]
    },
    "SourceType": {
      "type": "string",
      "enum": [
        "MONITORING_SERVICE",
        "DEVICE_MONITORING",
        "DEVICE_WORKFLOW",
        "SYMPTOM_ENGINE",
        "ENGAGEMENT_SERVICE",
        "USER_INTERFACE"
      ]
    },
    "AppliesToType": {
      "type": "string",
      "enum": ["VITAL_SIGN", "DEVICE", "SYMPTOM", "ENGAGEMENT"]
    },
    "SeverityHint": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
    },
    "EvidenceMissedReading": {
      "type": "object",
      "description": "MISSED_READING evidence (strict). Required: eventTimestamp, source, inputType, appliesToType, linkedEntityCode, lastSuccessfulReadingTimestamp, missedDuration, readingType. Must match top-level inputType; source must match sourceType.",
      "required": [
        "eventTimestamp",
        "source",
        "inputType",
        "appliesToType",
        "linkedEntityCode",
        "lastSuccessfulReadingTimestamp",
        "missedDuration",
        "readingType"
      ],
      "properties": {
        "eventTimestamp": {
          "type": "string",
          "minLength": 1,
          "format": "date-time",
          "description": "When the missed-reading condition was observed (ISO-8601 date-time)."
        },
        "source": { "$ref": "#/definitions/SourceType" },
        "inputType": { "type": "string", "enum": ["MISSED_READING"] },
        "appliesToType": { "$ref": "#/definitions/AppliesToType" },
        "linkedEntityCode": {
          "type": "string",
          "minLength": 1,
          "description": "Product code for the linked entity (e.g. BP_SYSTOLIC); non-empty."
        },
        "lastSuccessfulReadingTimestamp": {
          "type": "string",
          "minLength": 1,
          "format": "date-time",
          "description": "Last good reading time before the miss (ISO-8601 date-time)."
        },
        "missedDuration": {
          "type": "string",
          "minLength": 1,
          "description": "Non-empty duration string (e.g. ISO-8601 P3D) or product-specific token."
        },
        "readingType": {
          "type": "string",
          "minLength": 1,
          "description": "Reading / vital family label (e.g. BLOOD_PRESSURE); non-empty."
        }
      },
      "additionalProperties": false,
      "example": {
        "eventTimestamp": "2026-04-17T10:00:00.000Z",
        "source": "DEVICE_MONITORING",
        "inputType": "MISSED_READING",
        "appliesToType": "VITAL_SIGN",
        "linkedEntityCode": "BP_SYSTOLIC",
        "lastSuccessfulReadingTimestamp": "2026-04-14T08:00:00.000Z",
        "missedDuration": "P3D",
        "readingType": "BLOOD_PRESSURE"
      }
    },
    "EvidenceMissingDevice": {
      "type": "object",
      "description": "MISSING_DEVICE evidence (strict). Required: eventTimestamp, source, inputType, appliesToType, linkedEntityCode, deviceLinked.",
      "required": [
        "eventTimestamp",
        "source",
        "inputType",
        "appliesToType",
        "linkedEntityCode",
        "deviceLinked"
      ],
      "properties": {
        "eventTimestamp": {
          "type": "string",
          "minLength": 1,
          "format": "date-time",
          "description": "When the missing-device condition was observed (ISO-8601 date-time)."
        },
        "source": { "$ref": "#/definitions/SourceType" },
        "inputType": { "type": "string", "enum": ["MISSING_DEVICE"] },
        "appliesToType": { "$ref": "#/definitions/AppliesToType" },
        "linkedEntityCode": {
          "type": "string",
          "minLength": 1,
          "description": "Product code for the device or catalog entry (e.g. WEIGHING_SCALE); non-empty."
        },
        "deviceLinked": {
          "type": "boolean",
          "description": "Whether the patient has an active link to the device in context."
        }
      },
      "additionalProperties": false,
      "example": {
        "eventTimestamp": "2026-04-17T10:00:00.000Z",
        "source": "DEVICE_WORKFLOW",
        "inputType": "MISSING_DEVICE",
        "appliesToType": "DEVICE",
        "linkedEntityCode": "WEIGHING_SCALE",
        "deviceLinked": false
      }
    },
    "EvidencePayload": {
      "type": "object",
      "description": "POST /alerts: discriminated by inputType (MISSED_READING | MISSING_DEVICE). Common fields: eventTimestamp, source, inputType, appliesToType, linkedEntityCode; plus variant fields. Strict: no extra properties. source must equal top-level sourceType.",
      "oneOf": [
        { "$ref": "#/definitions/EvidenceMissedReading" },
        { "$ref": "#/definitions/EvidenceMissingDevice" }
      ]
    },
    "CreateAlertRequest": {
      "type": "object",
      "description": "Create-alert body; organization from JWT. Required: inputEventId, inputType, sourceType, patientId, triggerTimestamp, evidencePayload. Optional: patientName, actorName (client display names). evidencePayload is EvidenceMissedReading or EvidenceMissingDevice (strict). Unknown top-level properties rejected.",
      "additionalProperties": false,
      "required": [
        "inputEventId",
        "inputType",
        "sourceType",
        "patientId",
        "triggerTimestamp",
        "evidencePayload"
      ],
      "properties": {
        "inputEventId": {
          "type": "string",
          "description": "Required. Client-generated idempotency key (e.g. from UI)."
        },
        "inputType": {
          "allOf": [{ "$ref": "#/definitions/CreateAlertInputType" }],
          "description": "Required. MISSED_READING or MISSING_DEVICE."
        },
        "sourceType": {
          "allOf": [{ "$ref": "#/definitions/SourceType" }],
          "description": "Required. Must match evidencePayload.source."
        },
        "patientId": { "type": "string", "description": "Required." },
        "patientName": {
          "type": "string",
          "description": "Optional. Patient display name from the UI; stored for list/detail."
        },
        "actorName": {
          "type": "string",
          "description": "Optional. Display name of the API caller (actor); not from JWT."
        },
        "carePlanInstanceId": {
          "type": "string",
          "description": "Optional. When the event is tied to an active care plan."
        },
        "packageAssignmentId": {
          "type": "string",
          "description": "Optional. Package context when relevant."
        },
        "triggerTimestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Required. When the condition occurred (ISO 8601 date-time)."
        },
        "severityHint": {
          "allOf": [{ "$ref": "#/definitions/SeverityHint" }],
          "description": "Optional."
        },
        "priority": {
          "type": "string",
          "enum": ["P0", "P1", "P2", "P3"],
          "description": "Optional. Resolved priority; derived from policy when omitted."
        },
        "alertPolicyTemplateVersionId": {
          "type": "string",
          "description": "Optional. Policy template version."
        },
        "thresholdTemplateVersionId": {
          "type": "string",
          "description": "Optional. Threshold template version when applicable."
        },
        "groupingKey": {
          "type": "string",
          "description": "Optional. Runtime grouping; may be computed server-side if omitted."
        },
        "triggerSummary": {
          "type": "string",
          "description": "Optional. Pre-rendered summary when not using a template."
        },
        "triggerSummaryTemplateCode": {
          "type": "string",
          "description": "Optional. Pair with triggerSummaryParams when set."
        },
        "triggerSummaryParams": {
          "type": "object",
          "additionalProperties": true,
          "description": "Optional unless triggerSummaryTemplateCode is set; then required (may be {})."
        },
        "evidencePayload": {
          "allOf": [{ "$ref": "#/definitions/EvidencePayload" }],
          "description": "Required. Per inputType; see EvidenceMissedReading or EvidenceMissingDevice."
        }
      },
      "example": {
        "inputEventId": "ui-missed-reading-001",
        "inputType": "MISSED_READING",
        "sourceType": "MONITORING_SERVICE",
        "patientId": "pat-123",
        "patientName": "Jane Doe",
        "actorName": "Dr. Smith",
        "triggerTimestamp": "2026-04-17T10:00:00.000Z",
        "evidencePayload": {
          "eventTimestamp": "2026-04-17T10:00:00.000Z",
          "source": "MONITORING_SERVICE",
          "inputType": "MISSED_READING",
          "appliesToType": "VITAL_SIGN",
          "linkedEntityCode": "BP_SYSTOLIC",
          "lastSuccessfulReadingTimestamp": "2026-04-14T08:00:00.000Z",
          "missedDuration": "P3D",
          "readingType": "BLOOD_PRESSURE"
        }
      }
    },
    "PatchAlertRequest": {
      "type": "object",
      "properties": {
        "alertState": {
          "type": "string",
          "enum": [
            "UNASSIGNED",
            "ASSIGNED",
            "IN_PROGRESS",
            "WAITING",
            "RESOLVED",
            "DISMISSED"
          ]
        },
        "assignedToUserId": {
          "type": "string",
          "description": "Assignee user id or null to clear assignment",
          "x-nullable": true
        },
        "slaBreachIndicator": { "type": "boolean" }
      },
      "example": {
        "alertState": "IN_PROGRESS",
        "assignedToUserId": "5fa85f64-5717-4562-b3fc-2c963f66afa8",
        "slaBreachIndicator": false
      }
    },
    "AlertIds": {
      "type": "array",
      "description": "One or many alert ids (single-select = array of one element).",
      "items": { "type": "string" },
      "minItems": 1,
      "maxItems": 100
    },
    "WorkflowAction": {
      "type": "string",
      "enum": ["ASSIGN", "START_WORK", "MOVE_TO_WAITING", "RESUME_WORK", "RESOLVE", "DISMISS"]
    },
    "WorkflowRequest": {
      "type": "object",
      "required": ["alertIds", "action", "performedByDisplayName"],
      "properties": {
        "alertIds": { "$ref": "#/definitions/AlertIds" },
        "action": { "$ref": "#/definitions/WorkflowAction" },
        "assignedToUserId": { "type": "string" },
        "assigneeDisplayName": { "type": "string" },
        "reasonCode": { "type": "string" },
        "comment": { "type": "string" },
        "closureComment": { "type": "string" },
        "performedByDisplayName": { "type": "string" }
      }
    },
    "AssignmentAction": {
      "type": "string",
      "enum": ["ASSIGN", "ASSIGN_TO_SELF", "REASSIGN", "UNASSIGN"]
    },
    "AssignmentRequest": {
      "type": "object",
      "required": ["action", "performedByDisplayName"],
      "properties": {
        "action": { "$ref": "#/definitions/AssignmentAction" },
        "assignToUserId": { "type": "string", "description": "Required for ASSIGN and REASSIGN." },
        "assigneeDisplayName": { "type": "string", "description": "Required for ASSIGN, REASSIGN, and ASSIGN_TO_SELF." },
        "performedByDisplayName": { "type": "string" }
      }
    },
    "AssignmentRequestBody": {
      "allOf": [
        {
          "type": "object",
          "required": ["alertIds"],
          "properties": { "alertIds": { "$ref": "#/definitions/AlertIds" } }
        },
        { "$ref": "#/definitions/AssignmentRequest" }
      ]
    },
    "PriorityUpdateRequestBody": {
      "type": "object",
      "required": ["alertIds", "priority", "performedByDisplayName"],
      "properties": {
        "alertIds": { "$ref": "#/definitions/AlertIds" },
        "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
        "performedByDisplayName": { "type": "string" }
      }
    },
    "NoteRequest": {
      "type": "object",
      "required": ["comment", "performedByDisplayName"],
      "properties": { "comment": { "type": "string" }, "performedByDisplayName": { "type": "string" } }
    },
    "ActivityType": {
      "type": "string",
      "enum": [
        "ALERT_CREATED",
        "ALERT_GROUPED",
        "ALERT_ASSIGNED",
        "ALERT_REASSIGNED",
        "ALERT_STATE_CHANGED",
        "EVIDENCE_ADDED_OR_UPDATED",
        "ALERT_RESOLVED",
        "ALERT_DISMISSED",
        "SLA_BREACHED",
        "NOTE_ADDED",
        "PRIORITY_CHANGED"
      ]
    },
    "EpochMillis": {
      "type": "integer",
      "format": "int64",
      "description": "Unix epoch milliseconds (UTC) for alert SLA instants and activity rows."
    },
    "PaginatedAlerts": {
      "type": "object",
      "description": "`data` for GET /alerts — items are AlertDetail (`toAlertDetail`).",
      "properties": {
        "items": {
          "type": "array",
          "items": { "$ref": "#/definitions/AlertDetail" }
        },
        "nextToken": { "type": "string", "description": "Opaque pagination cursor." }
      }
    },
    "AlertSummary": {
      "type": "object",
      "description": "Subset of persisted alert fields exposed on detail; instants are epoch ms (`toAlertDetail`).",
      "properties": {
        "alertId": { "type": "string" },
        "priority": { "type": "string" },
        "alertState": { "type": "string" },
        "inputType": { "type": "string" },
        "sourceType": { "type": "string" },
        "triggerSummary": { "type": "string" },
        "triggerTimestamp": { "$ref": "#/definitions/EpochMillis" },
        "groupingKey": { "type": "string" },
        "patientId": { "type": "string" },
        "patientName": { "type": "string" },
        "actorName": { "type": "string" },
        "assignedToUserId": { "type": "string", "x-nullable": true },
        "assignedToDisplayName": { "type": "string" },
        "slaBreachIndicator": { "type": "boolean" },
        "assignSlaDueAt": { "$ref": "#/definitions/EpochMillis" },
        "resolveSlaDueAt": { "$ref": "#/definitions/EpochMillis" },
        "createdAt": { "$ref": "#/definitions/EpochMillis" }
      }
    },
    "AlertDetail": {
      "allOf": [
        { "$ref": "#/definitions/AlertSummary" },
        {
          "type": "object",
          "properties": {
            "inputEventId": { "type": "string" },
            "orgId": { "type": "string" },
            "evidencePayload": { "type": "object", "additionalProperties": true },
            "groupId": { "type": "string" },
            "assignedAt": { "$ref": "#/definitions/EpochMillis" },
            "assignedBy": { "type": "string" },
            "statusUpdatedAt": { "$ref": "#/definitions/EpochMillis" },
            "statusUpdatedBy": { "type": "string" },
            "closureComment": { "type": "string" },
            "resolutionCode": { "type": "string" },
            "dismissReason": { "type": "string" },
            "assignSla": { "type": "integer" },
            "resolveSla": { "type": "integer" },
            "assignSlaBreachedAt": { "$ref": "#/definitions/EpochMillis" },
            "resolveSlaBreachedAt": { "$ref": "#/definitions/EpochMillis" },
            "updatedAt": { "$ref": "#/definitions/EpochMillis" },
            "carePlanInstanceId": { "type": "string" },
            "packageAssignmentId": { "type": "string" },
            "alertPolicyTemplateVersionId": { "type": "string" },
            "thresholdTemplateVersionId": { "type": "string" }
          }
        }
      ]
    },
    "SuccessEnvelopeAlertDetail": {
      "type": "object",
      "description": "ApiResponse.ok body with AlertDetail in `data` (POST /alerts, GET /alerts/{id}).",
      "properties": {
        "success": { "type": "boolean", "example": true },
        "statusCode": { "type": "integer", "example": 200 },
        "message": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "description": { "type": "string" },
            "severity": { "type": "string" }
          }
        },
        "data": { "$ref": "#/definitions/AlertDetail" },
        "error": { "type": "object", "x-nullable": true },
        "meta": {
          "type": "object",
          "properties": {
            "requestId": { "type": "string" },
            "timestamp": { "type": "string", "format": "date-time" },
            "version": { "type": "string", "enum": ["v1"] }
          }
        }
      }
    },
    "SuccessEnvelopePaginatedAlerts": {
      "type": "object",
      "description": "ApiResponse.ok body for GET /alerts.",
      "properties": {
        "success": { "type": "boolean", "example": true },
        "statusCode": { "type": "integer", "example": 200 },
        "message": { "type": "object" },
        "data": { "$ref": "#/definitions/PaginatedAlerts" },
        "error": { "type": "object", "x-nullable": true },
        "meta": { "type": "object" }
      }
    },
    "ActivityRecord": {
      "type": "object",
      "description": "One audit / timeline row for an alert.",
      "properties": {
        "activityId": { "type": "string" },
        "alertId": { "type": "string" },
        "activityType": { "$ref": "#/definitions/ActivityType" },
        "activityTimestamp": { "$ref": "#/definitions/EpochMillis" },
        "performedBy": { "type": "string" },
        "performedByDisplayName": { "type": "string" },
        "activityComment": { "type": "string" },
        "previousState": { "type": "string" },
        "newState": { "type": "string" },
        "previousPriority": { "type": "string" },
        "newPriority": { "type": "string" },
        "previousAssignee": { "type": "string" },
        "newAssignee": { "type": "string" },
        "evidencePayload": { "type": "object", "additionalProperties": true }
      }
    },
    "ActivityList": {
      "type": "object",
      "description": "Full activity timeline for one alert (no pagination).",
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "items": { "$ref": "#/definitions/ActivityRecord" }
        }
      },
      "example": {
        "items": [
          {
            "activityId": "a1b2c3d4-0000-0000-0000-000000000001",
            "alertId": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
            "activityType": "ALERT_CREATED",
            "activityTimestamp": 1735890300000,
            "performedBy": "SYSTEM"
          }
        ]
      }
    },
    "SuccessEnvelopeActivityList": {
      "type": "object",
      "description": "Standard ApiResponse.ok body; full activity list is in `data.items`.",
      "properties": {
        "success": { "type": "boolean", "example": true },
        "statusCode": { "type": "integer", "example": 200 },
        "data": { "$ref": "#/definitions/ActivityList" },
        "error": { "type": "object", "x-nullable": true },
        "message": { "type": "object" },
        "meta": { "type": "object" }
      },
      "example": {
        "success": true,
        "statusCode": 200,
        "data": {
          "items": [
            {
              "activityId": "a1b2c3d4-0000-0000-0000-000000000001",
              "alertId": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
              "activityType": "ALERT_CREATED",
              "activityTimestamp": 1735890300000,
              "performedBy": "SYSTEM"
            }
          ]
        },
        "error": null,
        "message": {
          "title": "SUCCESS",
          "description": "Request processed successfully",
          "severity": "SUCCESS"
        },
        "meta": { "requestId": "req-example", "timestamp": "2026-04-17T10:05:01.000Z", "version": "v1" }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "security": [],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/alerts/workflow": {
      "post": {
        "summary": "Apply alert workflow command",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/WorkflowRequest" }
          }
        ],
        "responses": {
          "200": {
            "description": "OK — updated alert detail when single-select; otherwise mutation summary",
            "schema": { "$ref": "#/definitions/SuccessEnvelopeAlertDetail" }
          },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Not found" },
          "409": { "description": "Illegal transition" },
          "422": { "description": "Validation error" }
        }
      }
    },
    "/alerts/assignment": {
      "post": {
        "summary": "Apply alert assignment action",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/AssignmentRequestBody" }
          }
        ],
        "responses": {
          "200": {
            "description": "OK — updated alert detail for single-select, or `{ alertIds }` for multi-select",
            "schema": { "$ref": "#/definitions/SuccessEnvelopeAlertDetail" }
          },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Not found" },
          "409": { "description": "Terminal state conflict" },
          "422": { "description": "Validation error" }
        }
      }
    },
    "/alerts/priority": {
      "patch": {
        "summary": "Update alert priority",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/PriorityUpdateRequestBody" }
          }
        ],
        "responses": {
          "200": {
            "description": "OK — updated alert detail for single-select, or `{ alertIds }` for multi-select",
            "schema": { "$ref": "#/definitions/SuccessEnvelopeAlertDetail" }
          },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Not found" },
          "422": { "description": "Validation error" }
        }
      }
    },
    "/alerts": {
      "get": {
        "summary": "List alerts (Team, My, or Patient)",
        "description": "Use `queue=TEAM` (default), `MY`, or `PATIENT`. For `queue=PATIENT` you must pass `patientId`. For `TEAM` or `MY`, omit `patientId` (patient timeline is `queue=PATIENT` only). Tenant/org scope comes from the JWT; results are filtered to that organization.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "queue",
            "in": "query",
            "required": false,
            "type": "string",
            "enum": ["TEAM", "MY", "PATIENT"],
            "default": "TEAM",
            "description": "`PATIENT` requires query param `patientId`."
          },
          {
            "name": "patientId",
            "in": "query",
            "required": false,
            "type": "string",
            "x-example": "pat-123",
            "description": "Required when queue=PATIENT; must be omitted for TEAM and MY."
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "type": "string",
            "enum": ["UNASSIGNED", "ASSIGNED", "IN_PROGRESS", "WAITING", "RESOLVED", "DISMISSED"],
            "description": "Filter by alert workflow / UI status (same as alertState)."
          },
          { "name": "priority", "in": "query", "required": false, "type": "string" },
          { "name": "inputType", "in": "query", "required": false, "type": "string" },
          {
            "name": "assignment",
            "in": "query",
            "required": false,
            "type": "string",
            "x-example": "5fa85f64-5717-4562-b3fc-2c963f66afa8",
            "description": "Assignee user id; returns alerts whose assignedToUserId matches (omit to not filter by assignee)."
          },
          {
            "name": "dateFrom",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "date-time"
          },
          {
            "name": "dateTo",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "date-time"
          },
          { "name": "search", "in": "query", "required": false, "type": "string" },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "type": "integer",
            "default": 20
          },
          { "name": "nextToken", "in": "query", "required": false, "type": "string" }
        ],
        "responses": {
          "200": {
            "description": "OK — list payload in standard success envelope (`data.items` are AlertDetail)",
            "schema": { "$ref": "#/definitions/SuccessEnvelopePaginatedAlerts" }
          },
          "400": {
            "description": "Bad request — e.g. `queue=PATIENT` without `patientId`, or `patientId` with `TEAM`/`MY`"
          },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" }
        }
      },
      "post": {
        "summary": "Create alert (required: inputEventId, inputType, sourceType, patientId, triggerTimestamp, evidencePayload)",
        "description": "Request body example shown in Swagger is **MISSED_READING** (see model `CreateAlertRequest`). For **MISSING_DEVICE**, align body with `EvidenceMissingDevice` example on that model (and matching `sourceType` / `evidencePayload.source`).",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/CreateAlertRequest" }
          }
        ],
        "responses": {
          "200": {
            "description": "OK — AlertDetail in `data` for new alert or same-org idempotent replay (HTTP 200 for both)",
            "schema": { "$ref": "#/definitions/SuccessEnvelopeAlertDetail" }
          },
          "400": { "description": "Bad request" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "409": {
            "description": "Conflict — e.g. IDEMPOTENCY_KEY_IN_USE (different org owns inputEventId); same-org replay uses 200"
          },
          "422": { "description": "Validation or business rule error" },
          "500": { "description": "Server error" }
        }
      }
    },
    "/alerts/{alertId}": {
      "get": {
        "summary": "Get alert by id",
        "description": "Returns AlertDetail with epoch-ms instants in the standard success envelope.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "alertId",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": { "$ref": "#/definitions/SuccessEnvelopeAlertDetail" }
          },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Not found" }
        }
      }
    },
    "/alerts/{alertId}/activity": {
      "get": {
        "summary": "Get alert activity timeline",
        "description": "Activity list for the alert (newest first). Query `notesOnly=true`|`false` (`true` = NOTE_ADDED only).",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "alertId",
            "in": "path",
            "required": true,
            "type": "string",
            "x-example": "3fa85f64-5717-4562-b3fc-2c963f66afa6"
          },
          {
            "name": "notesOnly",
            "in": "query",
            "required": false,
            "type": "string",
            "enum": ["true", "false"],
            "description": "`true` — NOTE_ADDED only; `false` or omit — full timeline."
          }
        ],
        "responses": {
          "200": {
            "description": "OK — activity rows in response body `data.items`",
            "schema": { "$ref": "#/definitions/SuccessEnvelopeActivityList" }
          },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Alert not found" }
        }
      }
    },
    "/alerts/{alertId}/notes": {
      "post": {
        "summary": "Add an operational note",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "alertId", "in": "path", "required": true, "type": "string" },
          { "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/NoteRequest" } }
        ],
        "responses": {
          "201": { "description": "Created" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Not found" },
          "422": { "description": "Validation error" }
        }
      }
    }
  }
