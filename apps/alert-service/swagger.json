{
  "swagger": "2.0",
  "info": {
    "title": "Alert Service API",
    "version": "1.0.0",
    "description": "Alerts: HTTP APIs only. See docs/services/alert-service for DynamoDB access patterns. API Gateway uses the shared Lambda authorizer; send a JWT in the `Authorization` header (value `Bearer <token>` or as required by your client)."
  },
  "securityDefinitions": {
    "bearerAuth": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "Bearer JWT from the identity provider. In Swagger UI, enter `Bearer <access_token>` or the raw token depending on your gateway/authorizer expectations."
    }
  },
  "security": [{ "bearerAuth": [] }],
  "definitions": {
    "CreateAlertRequest": {
      "type": "object",
      "description": "Create-alert payload from the HTTP UI. Aligns with `createAlertHttpBodySchema` (Zod). Org is resolved from the JWT. `inputEventId`, `inputType`, and `sourceType` are set server-side (new UUID idempotency key; ENGAGEMENT_TRIGGER / USER_INTERFACE for tracking).",
      "required": ["patientId", "triggerTimestamp", "evidencePayload"],
      "properties": {
        "patientId": { "type": "string" },
        "carePlanInstanceId": { "type": "string" },
        "packageAssignmentId": { "type": "string" },
        "triggerTimestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO-8601 date-time"
        },
        "appliesToType": {
          "type": "string",
          "enum": ["VITAL_SIGN", "DEVICE", "SYMPTOM", "ENGAGEMENT"]
        },
        "linkedEntityCode": { "type": "string" },
        "severityHint": {
          "type": "string",
          "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
        },
        "priority": {
          "type": "string",
          "enum": ["P0", "P1", "P2", "P3"]
        },
        "alertPolicyTemplateVersionId": { "type": "string" },
        "thresholdTemplateVersionId": { "type": "string" },
        "groupingKey": { "type": "string" },
        "triggerSummary": { "type": "string" },
        "triggerSummaryTemplateCode": { "type": "string" },
        "triggerSummaryParams": {
          "type": "object",
          "additionalProperties": true
        },
        "evidencePayload": {
          "type": "object",
          "description": "Non-empty object. For HTTP create, inputType is fixed server-side as ENGAGEMENT_TRIGGER (e.g. engagementType, channel, or context).",
          "minProperties": 1,
          "additionalProperties": true
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "security": [],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/alerts": {
      "post": {
        "summary": "Create alert (idempotency key generated server-side; no inputEventId/inputType/sourceType in body)",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/CreateAlertRequest" }
          }
        ],
        "responses": {
          "201": { "description": "Created" },
          "200": { "description": "Duplicate event (idempotent replay)" },
          "422": { "description": "Validation or business rule error" }
        }
      }
    },
    "/alerts/{alertId}": {
      "get": {
        "summary": "Get alert by id",
        "parameters": [
          { "name": "alertId", "in": "path", "required": true, "type": "string" }
        ],
        "responses": { "200": { "description": "OK" }, "404": { "description": "Not found" } }
      },
      "patch": {
        "summary": "Update assignment / state / SLA flag",
        "parameters": [
          { "name": "alertId", "in": "path", "required": true, "type": "string" },
          {
            "name": "body",
            "in": "body",
            "schema": {
              "type": "object",
              "properties": {
                "alertState": {
                  "type": "string",
                  "enum": ["OPEN", "ACK", "IN_PROGRESS", "CLOSED", "ESCALATED"]
                },
                "assignedToUserId": { "type": "string" },
                "slaBreachIndicator": { "type": "boolean" }
              }
            }
          }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/patients/{patientId}/alerts": {
      "get": {
        "summary": "List alerts for patient (GSI1)",
        "parameters": [
          { "name": "patientId", "in": "path", "required": true, "type": "string" },
          { "name": "openOnly", "in": "query", "type": "boolean" },
          { "name": "inputType", "in": "query", "type": "string" },
          { "name": "limit", "in": "query", "type": "integer" }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/organizations/{organizationId}/alerts": {
      "get": {
        "summary": "Org work queue (GSI2)",
        "parameters": [
          { "name": "organizationId", "in": "path", "required": true, "type": "string" },
          { "name": "state", "in": "query", "type": "string" },
          { "name": "unassignedOnly", "in": "query", "type": "boolean" },
          { "name": "limit", "in": "query", "type": "integer" }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/users/{userId}/alerts": {
      "get": {
        "summary": "User queue (GSI3)",
        "parameters": [
          { "name": "userId", "in": "path", "required": true, "type": "string" },
          { "name": "state", "in": "query", "type": "string" },
          { "name": "limit", "in": "query", "type": "integer" }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    }
  }
}
