{
  "openapi": "3.0.0",
  "components": {
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "statusCode": {
            "type": "integer"
          },
          "message": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "severity": {
                "type": "string"
              }
            }
          },
          "data": {
            "type": "object",
            "properties": {}
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "meta": {
            "type": "object",
            "properties": {
              "correlationId": {
                "type": "string"
              },
              "timestamp": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "info": {
    "title": "Beauty on Wheels - Authorizer Service",
    "description": "Shared Cognito JWT and identity RBAC API Gateway authorizer. This service does not expose HTTP routes.",
    "version": "1.0.0"
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {},
  "servers": [
    {
      "url": "https://{apiId}.execute-api.us-east-1.amazonaws.com/{stage}",
      "description": "Deployed API Gateway stage",
      "variables": {
        "apiId": {
          "default": "localhost",
          "description": "API Gateway id"
        },
        "stage": {
          "default": "dev",
          "description": "Deployment stage"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "Authorizer",
      "description": "TOKEN authorizer invoked by API Gateway"
    }
  ]
}