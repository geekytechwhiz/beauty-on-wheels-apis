                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/vendors/:vendorId/operations/summary?fromDate=2026-10-29&toDate=2026-10-29",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "vendors",
                ":vendorId",
                "operations",
                "summary"
              ],
              "query": [
                {
                  "key": "fromDate",
                  "value": "2026-10-29",
                  "description": "Required inclusive start date YYYY-MM-DD"
                },
                {
                  "key": "toDate",
                  "value": "2026-10-29",
                  "description": "Required inclusive end date YYYY-MM-DD"
                }
              ],
              "variable": [
                {
                  "key": "vendorId",
                  "value": "vendor-1"
                }
              ]
            },
            "description": "Owner or platform admin. Read-only Manager Home totals for package visits and one-time bookings. fromDate and toDate are required. Expected includes MISSED package visits and excludes CANCELLED. Package-linked bookings (planId) are excluded."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('operations summary path is vendor scoped', function () {",
                  "  pm.expect(pm.request.url.getPath()).to.include('/operations/summary');",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  const data = body.data || body;",
                  "  pm.test('operations summary shape', function () {",
                  "    pm.expect(data).to.have.keys('fromDate', 'toDate', 'timezone', 'metrics', 'needsAttention', 'communities');",
                  "    pm.expect(data.metrics).to.have.keys('expected', 'completed', 'inProgress', 'waiting', 'missed', 'cancelled');",
                  "    pm.expect(data.needsAttention).to.be.an('array');",
                  "    pm.expect(data.communities).to.be.an('array');",
                  "  });",
                  "}"
                ]
              }
            }
