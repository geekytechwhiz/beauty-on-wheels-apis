# Copy to .env in this folder for local serverless package/offline.
# Required when AWS SSO/MFA session is expired — avoids live STS for ${aws:accountId}.
#
# Find your dev account id: aws sts get-caller-identity --query Account --output text
AWS_ACCOUNT_ID=000000000000
AWS_REGION=us-east-1

# DynamoDB table used by handlers at runtime (offline hits real AWS unless mocked)
DEVICE_TABLE=device-table-dev
