{
  "name": "@api-hub/device-service",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "ensure-registry": "node ../../tools/mvrx-resource-registry/scripts/ensure-built.js",
    "prepackage": "pnpm run ensure-registry",
    "preoffline": "pnpm run ensure-registry",
    "deploy": "npx --no-install serverless deploy",
    "offline": "npx --no-install serverless offline --config serverless.offline.yml --stage dev",
    "package": "npx --no-install serverless package",
    "test": "cd ../.. && node node_modules/jest/bin/jest.js --config=apps/device-service/jest.config.cts"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "defaultConfiguration": "production",
        "options": {
          "platform": "node",
          "outputPath": "device-service/dist",
          "format": [
            "cjs"
          ],
          "bundle": false,
          "main": "device-service/src/index.ts",
          "tsConfig": "device-service/tsconfig.app.json",
          "assets": [
            "device-service/src/assets"
          ],
          "esbuildOptions": {
            "sourcemap": true,
            "outExtension": {
              ".js": ".js"
            }
          }
        },
        "configurations": {
          "development": {},
          "production": {
            "esbuildOptions": {
              "sourcemap": false,
              "outExtension": {
                ".js": ".js"
              }
            }
          }
        }
      }
    }
  },
  "dependencies": {
   
  },
  "devDependencies": {
    "@myvitalrx/mvrx-resource-registry": "workspace:*",
    "esbuild": "^0.19.2",
    "serverless": "^3.40.0",
    "serverless-auto-swagger": "^3.1.0",
    "serverless-dotenv-plugin": "^6.0.0",
    "serverless-esbuild": "^1.57.0",
    "serverless-offline": "13.9.0"
  },
  "engines": {
    "node": ">=22"
  }
}
