# Optional. If BOTH are set, the app uses them for DynamoDB keys.
# If either is omitted, the Lambda calls DescribeTable once and reads HASH/RANGE names (works with DevOps tables).
#
# METADATA_REGISTRY_PK_ATTR=pk
# METADATA_REGISTRY_SK_ATTR=sk
#
# User display names on GET metadata (createdBy / lastModifiedBy). Dev: user-table-dev
# USER_TABLE=user-table-dev
