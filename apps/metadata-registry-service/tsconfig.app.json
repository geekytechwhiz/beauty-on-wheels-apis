{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": "../..",
    "rootDir": "../..",
    "outDir": "../../dist/apps/metadata-registry-service",
    "types": ["node"],
    "tsBuildInfoFile": "../../dist/apps/metadata-registry-service/tsconfig.app.tsbuildinfo",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "paths": {
      "@api-hub/metadata": ["libs/metadata/src/index.ts"],
      "@api-hub/observability": ["libs/observability/src/index.ts"],
      "@api-hub/utils": ["libs/utils/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts"],
  "references": [
    {
      "path": "../../libs/utils/tsconfig.lib.json"
    },
    {
      "path": "../../libs/metadata/tsconfig.lib.json"
    },
    {
      "path": "../../libs/middleware/tsconfig.lib.json"
    },
  ]
}
