{
  "name": "organization-service",
  "projectType": "application",
  "sourceRoot": "apps/organization-service/src",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "options": {
        "outputPath": "dist/apps/organization-service",
        "main": "apps/organization-service/src/index.ts",
        "tsConfig": "apps/organization-service/tsconfig.app.json"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "options": {
        "jestConfig": "apps/organization-service/jest.config.ts",
        "passWithNoTests": true
      }
    },
    "validate-policy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx tools/mvrx-policy-validator/src/index.ts {projectRoot}/serverless.yml {projectRoot}/serverless.yaml --only-changed"
      }
    }
  },
  "tags": [
    "type:app"
  ]
}
