{
  "openapi": "3.0.0",
  "info": {
    "title": "Organization Service API",
    "version": "1.0.0",
    "description": "RESTful API for managing organizations, users, devices, metadata, and files"
  },
  "components": {
    "schemas": {
      "SuccessResponse": {
        "type": "object",
        "properties": {
          "data": {
            "description": "Response data (can be object, array, or null)",
            "oneOf": [
              { "type": "object" },
              { "type": "array" },
              { "type": "null" }
            ]
          },
          "meta": {
            "type": "object",
            "description": "Additional metadata (optional)",
            "additionalProperties": true
          },
          "links": {
            "type": "object",
            "description": "Related resource links (optional)",
            "additionalProperties": {
              "type": "string"
            }
          },
          "requestId": {
            "type": "string",
            "description": "Request correlation ID",
            "example": "req-123"
          },
          "message": {
            "type": "string",
            "description": "Success message (optional)",
            "example": "Operation completed successfully"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "nullable": true },
          "title": { "type": "string" },
          "status": { "type": "integer" },
          "detail": { "type": "string" },
          "instance": { "type": "string", "nullable": true },
          "code": { "type": "string" },
          "correlationId": { "type": "string" },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": { "type": "string" },
                "message": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
