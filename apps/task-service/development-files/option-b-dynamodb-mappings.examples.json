  "apiMappings": {
    "POST /tasks/generate-care-plan": {
      "conditionExpression": "attribute_not_exists(SK)",
      "transactItems": [
        "PutItem META (reminderEnabled, reminderSettings optional)",
        "PutItem HIST#<transitionAtMs13>#<taskStateHistoryId> historyEventType=StateChange",
        "PutItem LOOKUP (taskSk, dueWindowStart, dueWindowEnd, reminderHistory=[] optional)"
      ],
      "outboundOptional": ["RegisterReminderJobs → HIST#<ms13>#<histId> ReminderRegisterRequest + LOOKUP reminderHistory append"]
    },
    "POST /tasks": {
      "conditionExpression": "attribute_not_exists(SK)",
      "transactItems": [
        "PutItem META with Owner* when staff task",
        "PutItem HIST#<transitionAtMs13>#<taskStateHistoryId> StateChange",
        "PutItem LOOKUP",
        "GSI1 when ownerType=User"
      ],
      "itemRefs": ["metaStaffTask", "lookupStaffTask", "histStateChangeCreate"]
    },
    "POST /tasks/{id}/state": {
      "description": "One TransactWriteItems per request. Always 2 writes; LOOKUP/EVID are conditional on target state.",
      "updateMeta": { "immutableSk": true, "immutableLsi1Sk": true },
      "always": [
        "UpdateItem META — currentState, lastUpdatedAt (Condition: currentState = expectedCurrentState)",
        "PutItem HIST#<transitionAtMs13>#<taskStateHistoryId> — historyEventType=StateChange (attribute_not_exists(SK))"
      ],
      "conditionalByToState": {
        "Completed": {
          "writes": [
            "UpdateItem LOOKUP — evidenceSummary rollup + cancel open reminderHistory entries",
            "PutItem EVID# — optional; only when manual completion stores proof (completionSource=Manual)",
            "PutItem HIST#<transitionAtMs13>#<taskStateHistoryId> ReminderCancelRequest — optional audit before outbound CancelReminderJobs"
          ],
          "notRequired": ["EVID# when action is Complete without evidence payload"],
          "itemRefs": ["histStateChangeComplete", "evidenceLinked", "lookupWithEvidenceSummary", "histReminderCancelRequest"]
        },
        "Dismissed": {
          "writes": [
            "UpdateItem LOOKUP — cancel reminderHistory (mark Scheduled entries Cancelled)",
            "PutItem HIST#<transitionAtMs13>#<taskStateHistoryId> ReminderCancelRequest — optional",
            "outbound CancelReminderJobs"
          ],
          "notRequired": ["EVID#", "evidenceSummary rollup"],
          "itemRefs": ["histStateChangeDismissed", "lookupAfterDismissOrCancel"]
        },
        "Cancelled": {
          "writes": [
            "UpdateItem LOOKUP — cancel reminderHistory",
            "PutItem HIST#<transitionAtMs13>#<taskStateHistoryId> ReminderCancelRequest — optional",
            "outbound CancelReminderJobs"
          ],
          "notRequired": ["EVID#", "evidenceSummary rollup unless product stores cancel reason as summary"],
          "itemRefs": ["histStateChangeCancelled", "lookupAfterDismissOrCancel"]
        },
        "Missed": {
          "writes": [
            "UpdateItem LOOKUP — evidenceSummary with missedAt optional; cancel reminderHistory if still Scheduled"
          ],
          "notRequired": ["EVID#"],
          "itemRefs": []
        },
        "Active": {
          "writes": [],
          "notRequired": ["EVID#", "LOOKUP evidenceSummary", "LOOKUP reminderHistory cancel"],
          "note": "e.g. reopen or non-terminal transition only"
        }
      },
      "transactItemCount": {
        "minimum": 2,
        "typicalComplete": "4 (META + HIST StateChange + LOOKUP + optional EVID)",
        "typicalCancelOrDismiss": "3 (META + HIST StateChange + LOOKUP reminderHistory cancel)"
      }
    },
    "PUT /tasks/{id}/reminder-settings": {
      "note": "Portal path TBD in OpenAPI",
      "transactItems": [
        "UpdateItem META reminderEnabled, reminderSettings",
        "PutItem HIST#<transitionAtMs13>#<taskStateHistoryId> historyEventType=reminderSettingsChange"
      ],
      "itemRefs": ["metaCarePlanTask after update", "histReminderSettingsChange"],
      "outbound": ["RegisterReminderJobs / CancelReminderJobs per REM-010"]
    },
    "PUT /tasks/{id}/owner": {
      "note": "Portal path TBD in OpenAPI",
      "transactItems": [
        "UpdateItem META Owner*, assignedToStaffId, gsi1Pk if User",
        "PutItem HIST#<transitionAtMs13>#<taskStateHistoryId> historyEventType=OwnerChange"
      ],
      "itemRefs": ["metaStaffTaskAfterOwnerReassign", "histOwnerChange"]
    },
    "GET /tasks/{id}": {
      "reads": [
        "GetItem LOOKUP → dueWindowStart, dueWindowEnd, reminderHistory, evidenceSummary",
        "GetItem META via taskSk → reminderEnabled, reminderSettings",
        "Query HIST# optional",
        "Query EVID# optional"
      ]
    },
    "GET /tasks/{id}/history": {
      "reads": ["Query PK=TASK#<id> begins_with HIST#", "ScanIndexForward=false (SK time-desc)"],
      "includesEventTypes": ["StateChange", "OwnerChange", "reminderSettingsChange", "ReminderRegisterRequest", "ReminderCancelRequest"]
    },
    "GET /care-plans/{carePlanInstanceId}/task-status-summary": {
      "query": { "index": "CarePlanIndex", "lsi1Prefix": "CP#<carePlan>#", "filterWorkflowStage": true }
    },
    "GET /staff/tasks": {
      "query": {
        "index": "StaffPatientTasksIndex",
        "gsi1Pk": "ORG#<org>#STAFF#<OwnerUserId>",
        "filterOptional": ["patientId", "ownerRoleCode", "ownerTeamId"],
        "surfaceSectionFilter": "derived in service after GSI1 query — not stored on META"
      }
    }
  },
  "events": {
    "CarePlanTaskGenerationTriggered": {
      "sameAs": "POST /tasks/generate-care-plan"
    },
    "LinkedSourceObjectCompleted": {
      "requiredPayload": ["patientId", "completionSourceType", "completionSourceReferenceId", "completionEventId", "completedAt"],
      "resolve": "Query patient PK begins_with DUE# + FilterExpression completionSourceType/ReferenceID",
      "transactItems": [
        "UpdateItem META currentState=Completed",
        "PutItem HIST#<transitionAtMs13>#<taskStateHistoryId> StateChange",
        "PutItem EVID# attribute_not_exists(SK)",
        "UpdateItem LOOKUP evidenceSummary + reminderHistory cancel"
      ],
      "itemRefs": ["evidenceLinked", "lookupWithEvidenceSummary", "histStateChangeComplete"]
    },
    "SchedulerWindowExecution": {
      "reads": ["GetItem LOOKUP", "GetItem META via taskSk"],
      "writes": ["UpdateItem LOOKUP reminderHistory status Sent"],
      "outbound": ["SendReminderRequest"]
    },
    "RegisterReminderJobs": {
      "writes": [
        "PutItem HIST#<transitionAtMs13>#<taskStateHistoryId> ReminderRegisterRequest optional",
        "UpdateItem LOOKUP append reminderHistory Scheduled"
      ],
      "itemRefs": ["histReminderRegisterRequest", "lookupWithreminderHistory"]
    },
    "CancelReminderJobs": {
      "writes": [
        "PutItem HIST#<transitionAtMs13>#<taskStateHistoryId> ReminderCancelRequest optional",
        "UpdateItem LOOKUP reminderHistory Cancelled"
      ],
      "itemRefs": ["histReminderCancelRequest"]
    }
  },
  "enums": {
    "runtimeTaskSource": ["CarePlanTaskLinkage", "MonitoringRuntime", "ServiceFlowRuntime", "ManualSystem"],
    "currentState": ["Scheduled", "Active", "Completed", "Missed", "Dismissed", "Cancelled"],
    "surfaceSectionApiDerived": ["Today", "Upcoming", "NeedsAttention", "History", "CarePlanChecklist"],
    "ownerType": ["User", "Role", "Team"],
    "historyEventType": ["StateChange", "OwnerChange", "reminderSettingsChange", "ReminderRegisterRequest", "ReminderCancelRequest"],
    "ReminderChannel": ["Push", "SMS", "Email", "InApp"],
    "ReminderStatus": ["Scheduled", "Sent", "Cancelled", "Failed", "Suppressed"],
    "transitionSource": ["Manual", "Scheduler", "SourceEvent", "System"],
    "ReadinessStatus": ["Ready", "NotReady", "NotApplicable"],
    "IdempotencyOutcome": ["Created", "SkippedDuplicate"]
  }
}
