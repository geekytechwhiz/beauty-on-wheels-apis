{
  "swagger": "2.0",
  "info": {
    "title": "Task Service API",
    "version": "1.0.0",
    "description": "Task Service HTTP APIs. Deployed Swagger UI uses this file + serverless-auto-swagger."
  },
  "schemes": ["https", "http"],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "securityDefinitions": {
    "bearerAuth": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "Bearer JWT from the identity provider."
    }
  },
  "definitions": {
    "EpochMillis": {
      "type": "integer",
      "format": "int64",
      "description": "Unix epoch milliseconds (UTC)."
    },
    "TaskBehaviorCode": {
      "type": "string",
      "enum": [
        "INSTRUCTION",
        "DOCUMENT_FORM",
        "UPLOAD_DOCUMENT",
        "DEVICE_SETUP",
        "EDUCATION_VIDEO",
        "EDUCATION_ARTICLE",
        "CARE_TEAM_TASK",
        "METRIC_CHECKIN",
        "SYMPTOM_CHECKIN"
      ]
    },
    "IdempotencyOutcome": {
      "type": "string",
      "enum": ["created", "skippedDuplicate"]
    },
    "CreateMonitoringActionRequest": {
      "type": "object",
      "required": [
        "patientId",
        "patientDisplayName",
        "carePlanInstanceId",
        "monitoringInstanceId",
        "taskBehaviorCode",
        "assignedToType",
        "dueWindowStart",
        "dueWindowEnd"
      ],
      "properties": {
        "patientId": {
          "type": "string",
          "description": "Patient id from request body (not from JWT)."
        },
        "patientDisplayName": {
          "type": "string",
          "description": "Patient display name from request body (not from JWT)."
        },
        "carePlanInstanceId": { "type": "string" },
        "monitoringInstanceId": { "type": "string" },
        "taskBehaviorCode": { "$ref": "#/definitions/TaskBehaviorCode" },
        "assignedToType": { "$ref": "#/definitions/AssignedToType" },
        "assignedToStaffId": {
          "type": "string",
          "description": "Staff user id when assignedToType is staff; drives GSI1 staff inbox."
        },
        "assignedToStaffDisplayName": {
          "type": "string",
          "description": "Required when assignedToType is staff."
        },
        "dueWindowStart": { "$ref": "#/definitions/EpochMillis" },
        "dueWindowEnd": { "$ref": "#/definitions/EpochMillis" },
        "reminderContext": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false,
      "example": {
        "patientId": "pat-101",
        "patientDisplayName": "Maria Lopez",
        "carePlanInstanceId": "cp-2026-001",
        "monitoringInstanceId": "mon-bp-daily-001",
        "taskBehaviorCode": "METRIC_CHECKIN",
        "assignedToType": "patient",
        "dueWindowStart": 1780581600000,
        "dueWindowEnd": 1780668000000,
        "reminderContext": { "channels": ["Push", "InApp"] }
      }
    },
    "CreateMonitoringActionResult": {
      "type": "object",
      "required": ["runtimeTaskInstanceId", "outcome"],
      "properties": {
        "runtimeTaskInstanceId": { "type": "string" },
        "outcome": { "$ref": "#/definitions/IdempotencyOutcome" },
        "task": { "type": "object" }
      }
    },
    "RuntimeTaskSourceCreate": {
      "type": "string",
      "enum": ["serviceFlowRuntime", "manualSystem"]
    },
    "TaskDisplayGroup": {
      "type": "string",
      "enum": ["action", "learning", "checkIn", "staffTask"]
    },
    "AssignedToType": {
      "type": "string",
      "enum": ["patient", "careTeamRole", "user", "orgStaff", "system"],
      "description": "Who completes a runtime task. orgStaff inbox GSI1 is `ORG#<orgId>#STAFF#<assigneeId>`; other non-patient types use `ORG#<orgId>#STAFF#<assignedToType>#<assigneeId>`."
    },
    "WorkflowStage": {
      "type": "string",
      "enum": ["onboarding", "ongoing", "review", "closure"]
    },
    "CurrentState": {
      "type": "string",
      "enum": ["open", "scheduled", "active", "completed", "missed", "dismissed", "cancelled"],
      "description": "API wire uses open for in-progress tasks; active/scheduled are legacy persistence values normalized to open on read."
    },
    "SurfaceSection": {
      "type": "string",
      "enum": ["today", "upcoming", "needsAttention", "history", "carePlanChecklist"]
    },
    "RuntimeTaskCard": {
      "type": "object",
      "required": ["runtimeTaskInstanceId", "currentState"],
      "properties": {
        "runtimeTaskInstanceId": { "type": "string" },
        "patientId": { "type": "string" },
        "patientDisplayName": { "type": "string" },
        "displayTitle": { "type": "string" },
        "currentState": { "$ref": "#/definitions/CurrentState" },
        "taskBehaviorCode": { "$ref": "#/definitions/TaskBehaviorCode" },
        "taskDisplayGroup": { "$ref": "#/definitions/TaskDisplayGroup" },
        "assignedToType": { "$ref": "#/definitions/AssignedToType" },
        "dueWindowStart": { "$ref": "#/definitions/EpochMillis" },
        "dueWindowEnd": { "$ref": "#/definitions/EpochMillis" }
      },
      "additionalProperties": true
    },
    "PaginatedRuntimeTaskCards": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": { "$ref": "#/definitions/RuntimeTaskCard" }
        },
        "nextToken": { "type": "string" }
      }
    },
    "RuntimeTaskCardList": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": { "$ref": "#/definitions/RuntimeTaskCard" }
        }
      }
    },
    "SurfaceSectionActionCenter": {
      "type": "string",
      "enum": ["today", "upcoming", "needsAttention", "history", "carePlanChecklist", "all"]
    },
    "ActionCenterTaskCard": {
      "allOf": [
        { "$ref": "#/definitions/RuntimeTaskCard" },
        {
          "type": "object",
          "required": ["surfaceSection"],
          "properties": {
            "surfaceSection": { "$ref": "#/definitions/SurfaceSection" }
          }
        }
      ]
    },
    "ActionCenterGroupedSections": {
      "type": "object",
      "required": ["patientId", "timezone", "sections"],
      "properties": {
        "patientId": { "type": "string" },
        "carePlanInstanceId": { "type": "string" },
        "timezone": { "type": "string" },
        "sections": {
          "type": "object",
          "properties": {
            "today": { "type": "array", "items": { "$ref": "#/definitions/ActionCenterTaskCard" } },
            "upcoming": { "type": "array", "items": { "$ref": "#/definitions/ActionCenterTaskCard" } },
            "needsAttention": { "type": "array", "items": { "$ref": "#/definitions/ActionCenterTaskCard" } },
            "history": { "type": "array", "items": { "$ref": "#/definitions/ActionCenterTaskCard" } },
            "carePlanChecklist": { "type": "array", "items": { "$ref": "#/definitions/ActionCenterTaskCard" } }
          }
        },
        "nextToken": { "type": "string" }
      }
    },
    "ActionCenterSingleSection": {
      "type": "object",
      "required": ["patientId", "surfaceSection", "timezone", "items"],
      "properties": {
        "patientId": { "type": "string" },
        "carePlanInstanceId": { "type": "string" },
        "surfaceSection": { "$ref": "#/definitions/SurfaceSection" },
        "timezone": { "type": "string" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/definitions/ActionCenterTaskCard" }
        },
        "nextToken": { "type": "string" }
      }
    },
    "PatientTaskListResult": {
      "type": "object",
      "required": ["patientId", "patientTasks", "staffTasks"],
      "properties": {
        "patientId": { "type": "string" },
        "staffUserId": {
          "type": "string",
          "description": "Present when staffUserId query param was provided for in-patient staff bucket filtering."
        },
        "patientTasks": { "$ref": "#/definitions/RuntimeTaskCardList" },
        "staffTasks": {
          "$ref": "#/definitions/RuntimeTaskCardList",
          "description": "Populated only when staffUserId query param is provided; otherwise items is empty."
        },
        "nextToken": { "type": "string" }
      }
    },
    "CreateRuntimeTaskRequest": {
      "type": "object",
      "required": [
        "patientId",
        "patientDisplayName",
        "runtimeTaskSource",
        "taskBehaviorCode",
        "taskDisplayGroup",
        "displayTitle",
        "assignedToType",
        "displayToPatient"
      ],
      "properties": {
        "patientId": {
          "type": "string",
          "description": "Patient id from request body (not from JWT)."
        },
        "patientDisplayName": {
          "type": "string",
          "description": "Patient display name from request body (not from JWT)."
        },
        "carePlanInstanceId": { "type": "string" },
        "workflowStage": { "$ref": "#/definitions/WorkflowStage" },
        "runtimeTaskSource": { "$ref": "#/definitions/RuntimeTaskSourceCreate" },
        "taskBehaviorCode": { "$ref": "#/definitions/TaskBehaviorCode" },
        "taskDisplayGroup": { "$ref": "#/definitions/TaskDisplayGroup" },
        "displayTitle": { "type": "string" },
        "description": { "type": "string" },
        "assignedToType": { "$ref": "#/definitions/AssignedToType" },
        "assignedToStaffId": {
          "type": "string",
          "description": "Staff user id when assignedToType is staff; drives GSI1 staff inbox."
        },
        "assignedToStaffDisplayName": {
          "type": "string",
          "description": "Required when assignedToType is staff."
        },
        "displayToPatient": { "type": "boolean" },
        "actionTargetId": { "type": "string" },
        "completionSourceType": { "type": "string" },
        "completionSourceReferenceId": { "type": "string" },
        "dueWindowStart": { "$ref": "#/definitions/EpochMillis" },
        "dueWindowEnd": { "$ref": "#/definitions/EpochMillis" },
        "reminderEnabled": { "type": "boolean" },
        "requiredForStageCompletion": { "type": "boolean" },
        "displayAsChecklistItem": { "type": "boolean" }
      },
      "additionalProperties": false,
      "example": {
        "patientId": "pat-8f2c91a4-7e3b-4d1a-9c55-2a1f0e883201",
        "patientDisplayName": "Maria Lopez",
        "carePlanInstanceId": "cp-inst-onboard-2026-04-001",
        "workflowStage": "ongoing",
        "runtimeTaskSource": "manualSystem",
        "taskBehaviorCode": "CARE_TEAM_TASK",
        "taskDisplayGroup": "staffTask",
        "displayTitle": "Call patient about missed reading",
        "description": "Follow up on missed BP reading from yesterday",
        "assignedToType": "orgStaff",
        "assignedToStaffId": "staff-nurse-44721",
        "assignedToStaffDisplayName": "Nurse Lee",
        "displayToPatient": false,
        "dueWindowStart": 1780581600000,
        "dueWindowEnd": 1780668000000,
        "reminderEnabled": false
      }
    },
    "CreateRuntimeTaskResult": {
      "type": "object",
      "required": ["runtimeTaskInstanceId", "task"],
      "properties": {
        "runtimeTaskInstanceId": { "type": "string" },
        "task": { "type": "object" }
      }
    },
    "CarePlanLinkageMaterialization": {
      "type": "object",
      "required": [
        "carePlanTaskLinkageId",
        "taskBehaviorCode",
        "taskDisplayGroup",
        "displayTitle",
        "assignedToType",
        "displayToPatient",
        "dueWindowStart",
        "dueWindowEnd"
      ],
      "properties": {
        "carePlanTaskLinkageId": { "type": "string" },
        "sourceTaskTemplateVersionId": { "type": "string" },
        "taskBehaviorCode": { "$ref": "#/definitions/TaskBehaviorCode" },
        "taskDisplayGroup": { "$ref": "#/definitions/TaskDisplayGroup" },
        "displayTitle": { "type": "string" },
        "description": { "type": "string" },
        "assignedToType": { "$ref": "#/definitions/AssignedToType" },
        "assignedToStaffId": {
          "type": "string",
          "description": "Staff user id when assignedToType is staff; drives GSI1 staff inbox."
        },
        "assignedToStaffDisplayName": {
          "type": "string",
          "description": "Required when assignedToType is staff."
        },
        "displayToPatient": { "type": "boolean" },
        "actionTargetId": { "type": "string" },
        "completionSourceType": { "type": "string" },
        "completionSourceReferenceId": { "type": "string" },
        "dueWindowStart": { "$ref": "#/definitions/EpochMillis" },
        "dueWindowEnd": { "$ref": "#/definitions/EpochMillis" },
        "reminderEnabled": { "type": "boolean" },
        "reminderSettings": {
          "type": "object",
          "additionalProperties": true
        },
        "requiredForStageCompletion": { "type": "boolean" },
        "displayAsChecklistItem": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "GenerateCarePlanTasksRequest": {
      "type": "object",
      "required": [
        "patientId",
        "patientDisplayName",
        "carePlanInstanceId",
        "taskGenerationTrigger",
        "sourceLinkageContext"
      ],
      "properties": {
        "patientId": {
          "type": "string",
          "description": "Patient id from request body (not from JWT)."
        },
        "patientDisplayName": {
          "type": "string",
          "description": "Patient display name from request body (not from JWT)."
        },
        "carePlanInstanceId": { "type": "string" },
        "taskGenerationTrigger": { "type": "string" },
        "workflowStage": { "$ref": "#/definitions/WorkflowStage" },
        "dryRun": { "type": "boolean" },
        "actorType": { "type": "string" },
        "actorId": {
          "type": "string",
          "description": "When set, createdBy becomes system:care-plan-runtime:<actorId>."
        },
        "sourceLinkageContext": {
          "type": "object",
          "required": ["linkages"],
          "properties": {
            "linkages": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/definitions/CarePlanLinkageMaterialization" }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "example": {
        "patientId": "pat-maria",
        "patientDisplayName": "Maria Lopez",
        "carePlanInstanceId": "cp-maria-001",
        "taskGenerationTrigger": "carePlanStageEntered",
        "workflowStage": "onboarding",
        "dryRun": false,
        "actorType": "system",
        "actorId": "care-plan-runtime",
        "sourceLinkageContext": {
          "linkages": [
            {
              "carePlanTaskLinkageId": "link-watch-bp-video",
              "sourceTaskTemplateVersionId": "task-tpl-education-video-v3",
              "taskBehaviorCode": "EDUCATION_VIDEO",
              "taskDisplayGroup": "learning",
              "displayTitle": "Watch: How to measure BP",
              "assignedToType": "patient",
              "displayToPatient": true,
              "actionTargetId": "video-how-to-measure-bp",
              "dueWindowStart": 1780567200000,
              "dueWindowEnd": 1780610400000,
              "requiredForStageCompletion": true,
              "displayAsChecklistItem": true,
              "reminderEnabled": true,
              "reminderSettings": { "channels": ["push"], "quietHoursRespected": true }
            }
          ]
        }
      }
    },
    "GeneratedCarePlanTaskResultItem": {
      "type": "object",
      "required": ["runtimeTaskInstanceId", "outcome", "task"],
      "properties": {
        "runtimeTaskInstanceId": { "type": "string" },
        "outcome": { "$ref": "#/definitions/IdempotencyOutcome" },
        "task": { "type": "object" }
      }
    },
    "GenerateCarePlanTasksResult": {
      "type": "object",
      "required": ["results"],
      "properties": {
        "results": {
          "type": "array",
          "items": { "$ref": "#/definitions/GeneratedCarePlanTaskResultItem" }
        }
      }
    },
    "ReminderRecord": {
      "type": "object",
      "additionalProperties": true
    },
    "CompletionEvidence": {
      "type": "object",
      "required": ["completionEvidenceId", "completedAt", "completionSource"],
      "properties": {
        "completionEvidenceId": { "type": "string" },
        "completionSource": { "type": "string" },
        "completionSourceType": { "type": "string" },
        "completionSourceReferenceId": { "type": "string" },
        "completionEventId": { "type": "string" },
        "completedAt": { "$ref": "#/definitions/EpochMillis" },
        "completedBy": { "type": "string" },
        "evidencePayload": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "TaskEvidenceSummary": {
      "type": "object",
      "required": ["generatedAt"],
      "properties": {
        "runtimeTaskInstanceId": { "type": "string" },
        "generatedAt": { "$ref": "#/definitions/EpochMillis" },
        "latestCompletionSummary": { "type": "string" }
      },
      "additionalProperties": true
    },
    "RuntimeTaskDetail": {
      "type": "object",
      "required": ["task"],
      "properties": {
        "task": { "type": "object" },
        "reminders": {
          "type": "array",
          "items": { "$ref": "#/definitions/ReminderRecord" }
        },
        "completionEvidence": {
          "type": "array",
          "items": { "$ref": "#/definitions/CompletionEvidence" }
        },
        "evidenceSummary": { "$ref": "#/definitions/TaskEvidenceSummary" }
      }
    },
    "TaskHistoryEventType": {
      "type": "string",
      "enum": [
        "stateChange",
        "assignedToStaffChange",
        "reminderSettingsChange",
        "reminderRegisterRequest",
        "reminderCancelRequest"
      ]
    },
    "TransitionSource": {
      "type": "string",
      "enum": ["manual", "scheduler", "sourceEvent", "system"]
    },
    "TaskHistoryEntry": {
      "type": "object",
      "required": ["taskStateHistoryId", "historyEventType", "transitionAt", "transitionBy", "transitionSource"],
      "properties": {
        "taskStateHistoryId": { "type": "string" },
        "historyEventType": { "$ref": "#/definitions/TaskHistoryEventType" },
        "transitionAt": { "$ref": "#/definitions/EpochMillis" },
        "fromState": { "type": "string" },
        "toState": { "type": "string" },
        "transitionBy": { "type": "string" },
        "transitionSource": { "$ref": "#/definitions/TransitionSource" },
        "transitionReason": { "type": "string" },
        "previousAssignedToStaffId": { "type": "string" },
        "newAssignedToStaffId": { "type": "string" },
        "previousAssignedToStaffDisplayName": { "type": "string" },
        "newAssignedToStaffDisplayName": { "type": "string" }
      }
    },
    "UpdateAssignedStaffRequest": {
      "type": "object",
      "required": ["actorId", "assignedToStaffId", "assignedToStaffDisplayName"],
      "properties": {
        "actorId": { "type": "string" },
        "assignedToStaffId": { "type": "string" },
        "assignedToStaffDisplayName": { "type": "string" },
        "reason": { "type": "string" }
      },
      "additionalProperties": false,
      "example": {
        "actorId": "staff-nurse-44721",
        "assignedToStaffId": "staff-nurse-55210",
        "assignedToStaffDisplayName": "Nurse Patel",
        "reason": "Shift handoff"
      }
    },
    "UpdateAssignedStaffResult": {
      "type": "object",
      "required": ["runtimeTaskInstanceId", "task", "historyEntry"],
      "properties": {
        "runtimeTaskInstanceId": { "type": "string" },
        "task": { "type": "object" },
        "historyEntry": { "$ref": "#/definitions/TaskHistoryEntry" }
      }
    },
    "PaginatedTaskHistory": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": { "$ref": "#/definitions/TaskHistoryEntry" }
        },
        "nextToken": { "type": "string" }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": { "description": "OK" }
        }
      }
    },
    "/tasks/monitoring-action": {
      "post": {
        "summary": "Create a monitoring-generated runtime task (idempotent)",
        "description": "Called by Monitoring Runtime. orgId from JWT; patientId and patientDisplayName from request body.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/CreateMonitoringActionRequest" }
          }
        ],
        "responses": {
          "200": {
            "description": "Create result (created or skipped duplicate).",
            "schema": { "$ref": "#/definitions/CreateMonitoringActionResult" }
          },
          "401": { "description": "Unauthorized" },
          "409": { "description": "Conflict (cross-org idempotency)" },
          "422": { "description": "Validation error" },
          "500": { "description": "Server error" }
        }
      }
    },
    "/tasks/generate-care-plan": {
      "post": {
        "summary": "Generate care-plan linkage runtime tasks (idempotent batch)",
        "description": "Called by Care Plan Runtime. orgId from JWT; patientId and patientDisplayName from request body.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/GenerateCarePlanTasksRequest" }
          }
        ],
        "responses": {
          "200": {
            "description": "Batch generate results (created or skipped duplicate per linkage).",
            "schema": { "$ref": "#/definitions/GenerateCarePlanTasksResult" }
          },
          "401": { "description": "Unauthorized" },
          "409": { "description": "Conflict (cross-org idempotency)" },
          "422": { "description": "Validation error" },
          "500": { "description": "Server error" }
        }
      }
    },
    "/tasks/{runtimeTaskInstanceId}": {
      "get": {
        "summary": "Get one runtime task detail",
        "description": "Full task context for detail views. Organization scope is from JWT; task must belong to the caller's org.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "path",
            "name": "runtimeTaskInstanceId",
            "required": true,
            "type": "string"
          },
          {
            "in": "query",
            "name": "includeRelated",
            "required": false,
            "type": "string",
            "enum": ["true", "false"],
            "default": "true"
          }
        ],
        "responses": {
          "200": {
            "description": "Task detail.",
            "schema": { "$ref": "#/definitions/RuntimeTaskDetail" }
          },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Runtime task not found" },
          "500": { "description": "Server error" }
        }
      }
    },
    "/tasks/{runtimeTaskInstanceId}/assigned-staff": {
      "put": {
        "summary": "Assign or reassign staff task to a staff member",
        "description": "Portal assign/reassign for staff tasks. Initial assignment sets assignedToStaffId plus GSI1 (gsi1Pk and gsi1Sk); reassignment updates gsi1Pk only. Appends HIST assignedToStaffChange audit. Organization scope from JWT only.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "path",
            "name": "runtimeTaskInstanceId",
            "required": true,
            "type": "string"
          },
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/UpdateAssignedStaffRequest" }
          }
        ],
        "responses": {
          "200": {
            "description": "Updated task and audit entry.",
            "schema": { "$ref": "#/definitions/UpdateAssignedStaffResult" }
          },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Runtime task not found" },
          "422": { "description": "Not a staff task or already assigned to this staff member" },
          "500": { "description": "Server error" }
        }
      }
    },
    "/tasks/{runtimeTaskInstanceId}/history": {
      "get": {
        "summary": "Get task audit history",
        "description": "Paged append-only HIST# timeline for one runtime task (newest first). Organization scope is from JWT.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "path",
            "name": "runtimeTaskInstanceId",
            "required": true,
            "type": "string"
          },
          {
            "in": "query",
            "name": "pageSize",
            "required": false,
            "type": "integer",
            "default": 50,
            "maximum": 200
          },
          {
            "in": "query",
            "name": "nextToken",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Paged history entries.",
            "schema": { "$ref": "#/definitions/PaginatedTaskHistory" }
          },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Runtime task not found" },
          "500": { "description": "Server error" }
        }
      }
    },
    "/tasks": {
      "get": {
        "summary": "List tasks by patient and (optionally) care plan",
        "description": "Patient-scoped task list for Mobile, Portal, or BFF. Organization scope from JWT only.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "query",
            "name": "patientId",
            "required": true,
            "type": "string"
          },
          {
            "in": "query",
            "name": "carePlanInstanceId",
            "required": false,
            "type": "string"
          },
          {
            "in": "query",
            "name": "workflowStage",
            "required": false,
            "type": "string",
            "enum": ["onboarding", "ongoing", "review", "closure"]
          },
          {
            "in": "query",
            "name": "staffUserId",
            "required": false,
            "type": "string",
            "description": "When set, staff-assigned tasks for this staff member appear in staffTasks; patientTasks excludes all staff-assigned tasks."
          },
          {
            "in": "query",
            "name": "currentState",
            "required": false,
            "type": "string",
            "enum": ["open", "scheduled", "active", "completed", "missed", "dismissed", "cancelled"]
          },
          {
            "in": "query",
            "name": "pageSize",
            "required": false,
            "type": "integer",
            "default": 50,
            "maximum": 200
          },
          {
            "in": "query",
            "name": "nextToken",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Patient-scoped task list split into patientTasks and staffTasks buckets.",
            "schema": { "$ref": "#/definitions/PatientTaskListResult" }
          },
          "400": { "description": "Bad request" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "500": { "description": "Server error" }
        }
      },
      "post": {
        "summary": "Create an ad-hoc/service-flow/manual runtime task",
        "description": "Called by Service Flow Runtime or authorized staff/system. orgId from JWT; patientId and patientDisplayName from request body. GSI1 when assignedToStaffId set.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/CreateRuntimeTaskRequest" }
          }
        ],
        "responses": {
          "200": {
            "description": "Success — new runtime task created.",
            "schema": { "$ref": "#/definitions/CreateRuntimeTaskResult" }
          },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "422": { "description": "Validation error" },
          "500": { "description": "Server error" }
        }
      }
    },
    "/action-center/items": {
      "get": {
        "summary": "Get Action Center items by surface section",
        "description": "Patient Action Center with server-derived surfaceSection. Mobile/Portal must render the returned section — do not re-bucket Today vs Upcoming client-side.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "query",
            "name": "patientId",
            "required": true,
            "type": "string"
          },
          {
            "in": "query",
            "name": "surfaceSection",
            "required": true,
            "type": "string",
            "enum": ["today", "upcoming", "needsAttention", "history", "carePlanChecklist", "all"]
          },
          {
            "in": "query",
            "name": "timezone",
            "required": false,
            "type": "string",
            "description": "IANA timezone for calendar Today (default UTC)."
          },
          {
            "in": "query",
            "name": "carePlanInstanceId",
            "required": false,
            "type": "string"
          },
          {
            "in": "query",
            "name": "workflowStage",
            "required": false,
            "type": "string",
            "enum": ["onboarding", "ongoing", "review", "closure"]
          },
          {
            "in": "query",
            "name": "pageSize",
            "required": false,
            "type": "integer",
            "default": 50,
            "maximum": 200
          },
          {
            "in": "query",
            "name": "nextToken",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Action Center grouped or single-section response.",
            "schema": {
              "type": "object",
              "properties": {
                "patientId": { "type": "string" },
                "sections": { "$ref": "#/definitions/ActionCenterGroupedSections/properties/sections" },
                "items": { "type": "array", "items": { "$ref": "#/definitions/ActionCenterTaskCard" } },
                "nextToken": { "type": "string" }
              }
            }
          },
          "400": { "description": "Bad request" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "500": { "description": "Server error" }
        }
      }
    },
    "/staff/tasks": {
      "get": {
        "summary": "List tasks assigned to the authenticated staff member",
        "description": "Staff inbox via GSI1. staffUserId must match JWT user id. Defaults to excluding terminal states when currentState is omitted.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "query",
            "name": "staffUserId",
            "required": true,
            "type": "string"
          },
          {
            "in": "query",
            "name": "patientId",
            "required": false,
            "type": "string"
          },
          {
            "in": "query",
            "name": "carePlanInstanceId",
            "required": false,
            "type": "string"
          },
          {
            "in": "query",
            "name": "currentState",
            "required": false,
            "type": "string",
            "enum": ["open", "scheduled", "active", "completed", "missed", "dismissed", "cancelled"]
          },
          {
            "in": "query",
            "name": "pageSize",
            "required": false,
            "type": "integer",
            "default": 50,
            "maximum": 200
          },
          {
            "in": "query",
            "name": "nextToken",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated staff task list.",
            "schema": { "$ref": "#/definitions/PaginatedRuntimeTaskCards" }
          },
          "400": { "description": "Bad request" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden — staffUserId must match authenticated user" },
          "500": { "description": "Server error" }
        }
      }
    }
  }
}
