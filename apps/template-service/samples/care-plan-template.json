{
  "templateId": "CARE_PLAN",
  "version": "1",
  "extendsTemplateId": null,
  "extendsVersion": null,
  "config": {
    "ui": {
      "showVitals": true,
      "defaultTab": "tasks"
    },
    "workflow": {
      "steps": ["intake", "assessment", "plan"]
    }
  },
  "rules": {
    "all": [
      { "op": "eq", "path": "carePlan.status", "value": "active" },
      { "op": "gte", "path": "patient.age", "value": 18 }
    ]
  },
  "actions": [
    { "type": "emit_event", "name": "CarePlan.Activated" },
    { "type": "assign_task", "taskCode": "FOLLOW_UP_7D" }
  ],
  "status": "published"
}
