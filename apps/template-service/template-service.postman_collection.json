{
  "info": {
    "_postman_id": "template-service-api-hub",
    "name": "Template Service API",
    "description": "Master template: **one POST API**\n- `POST /templates` → create (no id in path)\n- `POST /templates/{{templateId}}` → update or lifecycle\n\nSet `authToken`. After create, `templateId` is auto-set (e.g. TASK-CODE).\n\nshareScope: Private | Organization | Public\n\nGET /templates returns `items`, `pagination`, `counts`, `filterOptions`. Version history: GET /templates/{{templateId}}/versions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "authToken", "value": "" },
    { "key": "organizationId", "value": "org-apollo-001" },
    { "key": "templateId", "value": "TASK-CODE" },
    { "key": "masterTemplateId", "value": "TASK-CODE" },
    { "key": "versionId", "value": "" },
    { "key": "masterVersionId", "value": "" },
    { "key": "enablementId", "value": "" },
    { "key": "configId", "value": "TASK-MASTER-001" },
    { "key": "listNextToken", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET Health",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "Master — POST upsert (create & update)",
      "description": "POST /templates = create. POST /templates/{templateId} = update or lifecycle.",
      "item": [
        {
          "name": "POST Create Master (no id)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.data && j.data.templateId) {",
                  "  pm.collectionVariables.set('templateId', j.data.templateId);",
                  "  pm.collectionVariables.set('masterTemplateId', j.data.templateId);",
                  "}",
                  "if (j.data && j.data.templateVersionId) {",
                  "  pm.collectionVariables.set('versionId', j.data.templateVersionId);",
                  "  pm.collectionVariables.set('masterVersionId', j.data.templateVersionId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"templateLevel\": \"MASTER\",\n  \"templateType\": \"TASK\",\n  \"templateCode\": \"task-code\",\n  \"templateName\": \"Task Monitoring Master\",\n  \"categoryCode\": \"CHRONIC_CARE\",\n  \"shareScope\": \"private\",\n  \"active\": true,\n  \"conditionCode\": \"DIABETES\",\n  \"countryCodes\": [\"US\"],\n  \"languageCodes\": [\"EN\"],\n  \"version\": 1,\n  \"status\": \"DRAFT\",\n  \"measurementType\": \"NUMERIC\",\n  \"fieldValues\": {\n    \"TASK_NAME\": \"Record Blood Pressure\",\n    \"TASK_DESCRIPTION\": \"Measure BP daily\",\n    \"ASSIGNED_TO_ROLE\": \"PATIENT\",\n    \"TASK_CATEGORY\": \"MONITORING\",\n    \"TASK_TYPE\": \"MEASUREMENT\",\n    \"TASK_SUBTYPE\": \"BLOOD_PRESSURE\",\n    \"ACTION_SUBMISSION_TYPE\": \"DEVICE_SYNC\",\n    \"COMPARISON_METHOD\": \"RANGE\",\n    \"SCHEDULE_TYPE\": \"RECURRING\",\n    \"RECURRENCE_PATTERN\": \"DAILY\",\n    \"REMINDERS_ENABLED\": true,\n    \"REMINDER_CHANNELS\": [\"IN_APP\", \"PUSH\"],\n    \"DISPLAY_TO_PATIENT\": true\n  }\n}"
            },
            "url": "{{baseUrl}}/templates",
            "description": "Create master template. No templateId in URL. Response templateId e.g. TASK-CODE."
          }
        },
        {
          "name": "POST Update Master — set inactive (active: false)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"active\": false\n}"
            },
            "url": "{{baseUrl}}/templates/{{templateId}}",
            "description": "Same POST /templates/{templateId} API. Sets meta.isActive=false. Dashboard Active Count uses isActive."
          }
        },
        {
          "name": "POST Update Master — set active (active: true)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"active\": true\n}"
            },
            "url": "{{baseUrl}}/templates/{{templateId}}"
          }
        },
        {
          "name": "POST Update Master — edit content (by templateId)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shareScope\": \"Organization\",\n  \"fieldValues\": {\n    \"TASK_NAME\": \"Record Blood Pressure (updated)\",\n    \"TASK_DESCRIPTION\": \"Measure BP twice daily\"\n  }\n}"
            },
            "url": "{{baseUrl}}/templates/{{templateId}}",
            "description": "Use templateId (TASK-CODE), not templateVersionId. After create, collection variable templateId is set automatically."
          }
        },
        {
          "name": "POST Update Master — edit content (by versionId path)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shareScope\": \"Organization\",\n  \"fieldValues\": {\n    \"TASK_NAME\": \"Record Blood Pressure (updated)\",\n    \"TASK_DESCRIPTION\": \"Measure BP twice daily\"\n  }\n}"
            },
            "url": "{{baseUrl}}/templates/{{masterVersionId}}",
            "description": "Also accepts templateVersionId in path (TASK-CODE-V01); server resolves to template TASK-CODE."
          }
        },
        {
          "name": "POST Update Master — SUBMIT_REVIEW",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lifecycleAction\": \"SUBMIT_REVIEW\",\n  \"comment\": \"Ready for review\"\n}"
            },
            "url": "{{baseUrl}}/templates/{{templateId}}"
          }
        },
        {
          "name": "POST Update Master — PUBLISH",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lifecycleAction\": \"PUBLISH\",\n  \"comment\": \"Approved\"\n}"
            },
            "url": "{{baseUrl}}/templates/{{templateId}}",
            "description": "Run before POST /templates/{{masterTemplateId}}/derive."
          }
        },
        {
          "name": "POST Update Master — REJECT",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lifecycleAction\": \"REJECT\",\n  \"reason\": \"Needs clinical review\"\n}"
            },
            "url": "{{baseUrl}}/templates/{{templateId}}"
          }
        },
        {
          "name": "POST Update Master — ARCHIVE",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lifecycleAction\": \"ARCHIVE\",\n  \"comment\": \"Retired\"\n}"
            },
            "url": "{{baseUrl}}/templates/{{templateId}}"
          }
        }
      ]
    },
    {
      "name": "Templates — List & Read",
      "item": [
        {
          "name": "GET List Masters — TASK (dashboard)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.data?.pagination?.nextToken) {",
                  "  pm.collectionVariables.set('listNextToken', j.data.pagination.nextToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/templates?templateLevel=MASTER&templateType=TASK&limit=25",
              "host": ["{{baseUrl}}"],
              "path": ["templates"],
              "query": [
                { "key": "templateLevel", "value": "MASTER" },
                { "key": "templateType", "value": "TASK" },
                { "key": "limit", "value": "25" }
              ]
            },
            "description": "Returns items, pagination (limit/count/total/nextToken/hasMore), counts (total/active/draft/published/...), filterOptions (status/scope/condition)."
          }
        },
        {
          "name": "GET List Masters — TASK PUBLISHED",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/templates?templateLevel=MASTER&templateType=TASK&status=PUBLISHED",
              "host": ["{{baseUrl}}"],
              "path": ["templates"],
              "query": [
                { "key": "templateLevel", "value": "MASTER" },
                { "key": "templateType", "value": "TASK" },
                { "key": "status", "value": "PUBLISHED" }
              ]
            }
          }
        },
        {
          "name": "GET List Masters — filter shareScope + conditionCode",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/templates?templateLevel=MASTER&templateType=TASK&shareScope=Public&conditionCode=DIABETES",
              "host": ["{{baseUrl}}"],
              "path": ["templates"],
              "query": [
                { "key": "templateLevel", "value": "MASTER" },
                { "key": "templateType", "value": "TASK" },
                { "key": "shareScope", "value": "Public" },
                { "key": "conditionCode", "value": "DIABETES" }
              ]
            }
          }
        },
        {
          "name": "GET List Masters — page 2 (nextToken)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/templates?templateLevel=MASTER&templateType=TASK&limit=10&nextToken={{listNextToken}}",
              "host": ["{{baseUrl}}"],
              "path": ["templates"],
              "query": [
                { "key": "templateLevel", "value": "MASTER" },
                { "key": "templateType", "value": "TASK" },
                { "key": "limit", "value": "10" },
                { "key": "nextToken", "value": "{{listNextToken}}" }
              ]
            },
            "description": "Set collection variable listNextToken from data.pagination.nextToken after the first list call."
          }
        },
        {
          "name": "GET Versions — all + history timeline",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/templates/{{templateId}}/versions?templateLevel=MASTER",
              "host": ["{{baseUrl}}"],
              "path": ["templates", "{{templateId}}", "versions"],
              "query": [{ "key": "templateLevel", "value": "MASTER" }]
            },
            "description": "Returns items (version summaries) and history (timeline: title, action, version, updatedAt, updatedBy, notes, changes). Use for the Version History drawer in the UI."
          }
        },
        {
          "name": "GET Versions — latest",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/templates/{{templateId}}/versions?templateLevel=MASTER&version=latest",
              "host": ["{{baseUrl}}"],
              "path": ["templates", "{{templateId}}", "versions"],
              "query": [
                { "key": "templateLevel", "value": "MASTER" },
                { "key": "version", "value": "latest" }
              ]
            }
          }
        },
        {
          "name": "GET List Org Templates",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/templates?templateLevel=ORG&organizationId={{organizationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["templates"],
              "query": [
                { "key": "templateLevel", "value": "ORG" },
                { "key": "organizationId", "value": "{{organizationId}}" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Org — Derive, Update & Lifecycle",
      "item": [
        {
          "name": "POST Derive Org from Master",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.data && j.data.templateId) pm.collectionVariables.set('templateId', j.data.templateId);",
                  "if (j.data && j.data.templateVersionId) pm.collectionVariables.set('versionId', j.data.templateVersionId);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"organizationId\": \"{{organizationId}}\",\n  \"newTemplateName\": \"Apollo – Org copy\",\n  \"inheritLinks\": true\n}"
            },
            "url": "{{baseUrl}}/templates/{{masterTemplateId}}/derive"
          }
        },
        {
          "name": "PUT Update Org Version",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fieldValues\": {\n    \"TASK_NAME\": \"Record Blood Pressure (Org)\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/templates/{{templateId}}/versions/{{versionId}}?templateLevel=ORG&organizationId={{organizationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["templates", "{{templateId}}", "versions", "{{versionId}}"],
              "query": [
                { "key": "templateLevel", "value": "ORG" },
                { "key": "organizationId", "value": "{{organizationId}}" }
              ]
            }
          }
        },
        {
          "name": "POST Org Status — PUBLISH",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"PUBLISH\",\n  \"comment\": \"Approved\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/templates/{{templateId}}/versions/{{versionId}}/status?organizationId={{organizationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["templates", "{{templateId}}", "versions", "{{versionId}}", "status"],
              "query": [{ "key": "organizationId", "value": "{{organizationId}}" }]
            }
          }
        },
        {
          "name": "GET Compatible Published Templates",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/templates/compatible?condition=HYPERTENSION&country=US&templateType=CARE_PLAN",
              "host": ["{{baseUrl}}"],
              "path": ["templates", "compatible"],
              "query": [
                { "key": "condition", "value": "HYPERTENSION" },
                { "key": "country", "value": "US" },
                { "key": "templateType", "value": "CARE_PLAN" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Org Enablements",
      "item": [
        {
          "name": "POST Create Enablement",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "const id = j.data?.enablementId || j.data?.id;",
                  "if (id) pm.collectionVariables.set('enablementId', id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"organizationId\": \"{{organizationId}}\",\n  \"masterTemplateVersionId\": \"{{masterVersionId}}\",\n  \"effectiveFrom\": \"2026-01-01T00:00:00Z\"\n}"
            },
            "url": "{{baseUrl}}/org-enablements"
          }
        },
        {
          "name": "GET Search Enablements",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/org-enablements?organizationId={{organizationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["org-enablements"],
              "query": [{ "key": "organizationId", "value": "{{organizationId}}" }]
            }
          }
        }
      ]
    },
    {
      "name": "Template UI Configs",
      "item": [
        {
          "name": "GET List Configs by templateType",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/template-configs?configType=TEMPLATE&templateType=TASK",
              "host": ["{{baseUrl}}"],
              "path": ["template-configs"],
              "query": [
                { "key": "configType", "value": "TEMPLATE" },
                { "key": "templateType", "value": "TASK" }
              ]
            }
          }
        },
        {
          "name": "GET Config by Id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/template-configs/{{configId}}"
          }
        }
      ]
    },
    {
      "name": "Legacy",
      "item": [
        {
          "name": "POST /templates/master (legacy create path)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"templateCode\": \"TASK_LEGACY\",\n  \"templateType\": \"TASK\",\n  \"fieldValues\": { \"TASK_NAME\": \"Legacy path\" }\n}"
            },
            "url": "{{baseUrl}}/templates/master"
          }
        },
        {
          "name": "PUT /templates/{id} (removed — use POST)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lifecycleAction\": \"PUBLISH\"\n}"
            },
            "url": "{{baseUrl}}/templates/{{templateId}}",
            "description": "Deprecated. Use POST /templates/{{templateId}} instead."
          }
        }
      ]
    }
  ]
}
