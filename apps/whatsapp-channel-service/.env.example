STAGE=dev
DEFAULT_AWS_REGION=ap-south-1

# Secrets Manager name. Dev uses apdev-beauty-on-wheels/whatsapp.
# Production sets a different WHATSAPP_SECRET_NAME. Do not commit secret values.
WHATSAPP_SECRET_NAME=apdev-beauty-on-wheels/whatsapp
WHATSAPP_API_VERSION=v25.0
WHATSAPP_PHONE_NUMBER_ID=1431657753354506
WHATSAPP_BUSINESS_ACCOUNT_ID=1390181996618679
WHATSAPP_VERIFY_TOKEN=replace-me

# Leave empty. Deployed Lambdas read the JSON secret. These names are excluded from the package.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=

WHATSAPP_CONVERSATION_TABLE=whatsapp-channel-service-dev-conversations
CONVERSATION_TTL_SECONDS=1800
DOWNSTREAM_TIMEOUT_MS=8000
WHATSAPP_PROCESS_INLINE=true
INBOUND_QUEUE_URL=

CATALOG_SERVICE_URL=http://localhost:3001
AVAILABILITY_SERVICE_URL=http://localhost:3002
PRICING_SERVICE_URL=
BOOKING_SERVICE_URL=http://localhost:3003
USER_SERVICE_URL=http://localhost:3004
VEHICLE_SERVICE_URL=http://localhost:3005
VENDOR_SERVICE_URL=http://localhost:3006

SERVICE_AUTH_TOKEN=

WHATSAPP_PILOT_VENDOR_IDS=
WHATSAPP_CUSTOMER_LINKS=
WHATSAPP_BUSINESS_NAME=Beauty on Wheels
DEFAULT_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
METRICS_NAMESPACE=ApiHub
