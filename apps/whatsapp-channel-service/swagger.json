{
  "swagger": "2.0",
  "info": {
    "title": "WhatsApp Channel Service API",
    "version": "1.0.0",
    "description": "Meta webhook, outbound text messages, and health endpoints for the Beauty on Wheels WhatsApp channel. Downstream catalog, vendor, vehicle, availability, booking, and user calls are not exposed here."
  },
  "basePath": "/dev",
  "schemes": ["https"],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "operationId": "getHealth",
        "produces": ["application/json"],
        "responses": {
          "200": { "description": "Service is up" }
        }
      }
    },
    "/webhooks/whatsapp": {
      "get": {
        "summary": "Meta webhook verification",
        "operationId": "verifyWhatsAppWebhook",
        "parameters": [
          { "name": "hub.mode", "in": "query", "type": "string", "required": true },
          { "name": "hub.verify_token", "in": "query", "type": "string", "required": true },
          { "name": "hub.challenge", "in": "query", "type": "string", "required": true }
        ],
        "produces": ["text/plain", "application/json"],
        "responses": {
          "200": { "description": "hub.challenge echoed as plain text" },
          "403": { "description": "Verification token did not match" }
        }
      },
      "post": {
        "summary": "Meta webhook events",
        "operationId": "receiveWhatsAppWebhook",
        "parameters": [
          {
            "name": "X-Hub-Signature-256",
            "in": "header",
            "type": "string",
            "required": true,
            "description": "sha256 HMAC of the raw body using the Meta app secret"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": { "type": "object" }
          }
        ],
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "responses": {
          "200": { "description": "Event accepted and queued" },
          "401": { "description": "Invalid signature" },
          "400": { "description": "Body is not JSON" }
        }
      }
    },
    "/whatsapp/messages": {
      "post": {
        "summary": "Send a WhatsApp text message",
        "operationId": "sendWhatsAppMessage",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["to", "message"],
              "properties": {
                "to": {
                  "type": "string",
                  "description": "Recipient phone number in E.164 form, with or without a leading plus. Example: 919876543210"
                },
                "message": {
                  "type": "string",
                  "description": "Text body. Must not be empty."
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Meta accepted the message",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "type": "boolean" },
                "data": {
                  "type": "object",
                  "properties": {
                    "messageId": { "type": "string" },
                    "to": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": { "description": "Missing or invalid to or message" },
          "401": { "description": "Meta rejected the access token" },
          "403": { "description": "Meta rejected the request" },
          "500": { "description": "WhatsApp configuration is incomplete" },
          "502": { "description": "Meta API or network failure" },
          "504": { "description": "Meta API timed out" }
        }
      }
    }
  }
}
