flowchart LR

%% =========================
%% OLD FLOW (LEFT)
%% =========================
subgraph OLD["🔴 Current Flow (Synchronous)"]
    C1["1. Client"] --> A1["2. API Gateway"]
    A1 --> U1["3. create-user.ts"]

    U1 --> O1["4. Organization Service"]
    U1 --> DB1["5. Database"]
    U1 --> CG1["6. Cognito"]

    U1 --> R1["7. Role Service"]
    U1 --> D1["8. Doctor Linking"]
    U1 --> F1["9. Friend/Family"]
    U1 --> N1["10. Notification Service"]
end


%% =========================
%% NEW FLOW (CENTER)
%% =========================
subgraph NEW["🟢 New Flow (Async v1)"]
    C2["1. Client"] --> A2["2. API Gateway"]
    A2 --> U2["3. create-user.v1"]

    U2 --> O2["4. Organization Service"]
    U2 --> DB2["5. Database"]
    U2 --> CG2["6. Cognito"]

    U2 --> EB["7. EventBridge: UserCreated.v1"]
    U2 -->|Fallback| RQ["8. Retry Queue (SQS)"]
end


%% =========================
%% ASYNC CONSUMERS (RIGHT)
%% =========================
subgraph ASYNC["🔁 Async Processing"]
    EB --> RoleQ["9. Role Queue"]
    EB --> DoctorW["10. Doctor Worker"]
    EB --> FNFQ["11. FNF Queue"]
    EB --> NotifW["12. Notification Worker"]

    RoleQ --> RoleW["13. Role Worker"]
    FNFQ --> FNFW["14. FNF Worker"]

    RoleW --> RoleSvc["15. Role Service"]
    DoctorW --> DoctorSvc["16. Doctor Assignment"]
    FNFW --> FNFService["17. FNF Service"]
    NotifW --> NotifSvc["18. Notification Service"]
end


%% =========================
%% RETRY + DLQ
%% =========================
subgraph RETRY["⚠️ Retry & Failure Handling"]
    RQ --> RetryWorker["19. Retry Publisher"]
    RetryWorker --> EB
    RetryWorker -->|Fail| RetryDLQ["20. Retry DLQ"]

    RoleQ -->|Fail| RoleDLQ["21. Role DLQ"]
    FNFQ -->|Fail| FNFDLQ["22. FNF DLQ"]
end