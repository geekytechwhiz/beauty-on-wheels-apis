%% =====================================================
%% EVENT FLOW
%% =====================================================

P3 -->|LinkedOrgCarePlanVersionID| RT1

RT1 --> RT2
RT1 --> RT3

%% =====================================================
%% EVENT RULES
%% =====================================================

R1["Events notify availability, NOT forced adoption"]

R2["Runtime uses immutable published versions"]

R3["Metadata changes do NOT auto-update org templates"]

R4["Existing patient instances remain version-safe"]

EB --> R1
EB --> R2
EB --> R3
EB --> R4