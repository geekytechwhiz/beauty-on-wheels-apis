---
title: Care Plan Runtime — End-to-End (FE · BE · Flow)
---
flowchart TB

    classDef fe  fill:#dbeafe,stroke:#1d4ed8,stroke-width:2px
    classDef api fill:#ffedd5,stroke:#c2410c,stroke-width:2px
    classDef bus fill:#f3e8ff,stroke:#7e22ce,stroke-width:2px
    classDef rt  fill:#dcfce7,stroke:#15803d,stroke-width:2px
    classDef ws  fill:#e0e7ff,stroke:#4338ca,stroke-width:3px

    %% ═══════════════════════════════════════════════════════
    %% FRONTEND
    %% ═══════════════════════════════════════════════════════
    subgraph FE["Frontend"]
        WEB["Web App<br/>React Query · connect · subscribe"]
        MOB["Mobile App"]
    end

    %% ═══════════════════════════════════════════════════════
    %% BACKEND — API + EVENTS
    %% ═══════════════════════════════════════════════════════
    subgraph BE["Backend"]
        direction TB

        subgraph API["REST API"]
            AS["Alert Service"]
            DB[("Database")]
            AS <--> DB
        end

        subgraph EVT["Event Platform"]
            EB["EventBridge"]
            CON["Domain Consumer"]
            EB --> CON
        end

        EVT_SRC["Chat · Alert · Patient · Appointment events"] --> EB

        subgraph RT["Realtime — 3 delivery paths"]
            direction TB

            P1["Path A — Direct<br/>Realtime Middleware"]
            P2A["Path B — Aggregated<br/>SQS Realtime Queue"]
            P2B["Aggregation Lambda · 1–2 s window"]
            P2C["Group: ORG#TEAM_ALERTS · USER#MY_ALERTS · PATIENT#id"]
            P2A --> P2B --> P2C

            P3A["Path C — Subscription<br/>Realtime Middleware"]
            P3B["Subscription Store<br/>PATIENT#PAT101 → subscribers"]
            P3A --> P3B
        end
    end

    %% ═══════════════════════════════════════════════════════
    %% SHARED WEBSOCKET (from runtime-architecture)
    %% ═══════════════════════════════════════════════════════
    WS["Shared WebSocket Layer"]

    %% ─── ① Write ───────────────────────────────────────────
    WEB -->|"① Update alert"| AS
    AS -->|"② Publish AlertUpdated.v1 / AlertCreated.v1"| EB

    %% ─── ③ Path A: direct push (runtime-alert) ─────────────
    EB --> P1
    CON -->|"realtime enabled"| P1
    P1 -->|"ALERT_UPDATED"| WS

    %% ─── ④ Path B: SQS aggregation (runtime.sqs + aggregation-flow)
    EB -->|"AlertCreated.v1 × N"| P2A
    P2C -->|"TEAM_ALERTS_UPDATED"| WS

    %% ─── ⑤ Path C: scoped subscribe (runtime-alert-page) ───
    WEB -.->|"subscribe(PATIENT#…)"| P3B
    EB -->|"VitalUpdated.v1"| P3A
    P3B -->|"VITAL_UPDATED"| WS

    %% ─── ⑥ FE refresh (all paths) ──────────────────────────
    WS --> WEB & MOB
    WEB -->|"invalidateQueries → GET /alerts or /team-alerts"| AS

    class WEB,MOB fe
    class AS,DB api
    class EB,CON,EVT_SRC bus
    class P1,P2A,P2B,P2C,P3A,P3B rt
    class WS ws
