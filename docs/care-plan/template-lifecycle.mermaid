flowchart TB

%% =====================================================
%% MASTER TEMPLATE LIFECYCLE
%% =====================================================

subgraph MASTER["Master Template Lifecycle"]

A1[Create Master Template Draft]
A2[Validate Structure]
A3[Validate Metadata]
A4[Publish Master v1]

A5[Modify Template]
A6[Create Master v2]
A7[Publish Master v2]

A8[Master v1 Immutable]
A9[Master v2 Active]

A1 --> A2
A2 --> A3
A3 --> A4

A4 --> A5
A5 --> A6
A6 --> A7

A4 --> A8
A7 --> A9

end

%% =====================================================
%% ORG TEMPLATE DERIVATION
%% =====================================================

subgraph ORG["Org Template Lifecycle"]

B1[Clone Published Master]
B2[Create Org Draft]
B3[Apply Org Scope]
B4[Apply Metadata Allocation]
B5[Publish Org Template v1]

B6[Modify Org Template]
B7[Create Org Template v2]
B8[Publish Org Template v2]

B9[Previous Org Version Historical]
B10[Latest Org Version Active]

B1 --> B2
B2 --> B3
B3 --> B4
B4 --> B5

B5 --> B6
B6 --> B7
B7 --> B8

B5 --> B9
B8 --> B10

end

%% =====================================================
%% VERSIONING RULES
%% =====================================================

R1["Rule:
Published Templates are Immutable"]

R2["Rule:
Every Update Creates New Version"]

R3["Rule:
Org Templates can ONLY derive from Published Masters"]

R4["Rule:
Master Updates NEVER auto-update Org Templates"]

R5["Rule:
Latest Published Org Template becomes Active"]

MASTER --> R1
MASTER --> R2
ORG --> R3
ORG --> R4
ORG --> R5

%% =====================================================
%% UPGRADE FLOW
%% =====================================================

subgraph UPGRADE["Upgrade Flow"]

U1[New Master v2 Published]
U2[Org Reviews Upgrade]
U3[Create Upgrade Draft]
U4[Compare Differences]
U5[Preserve Org Overrides]
U6[Publish Upgraded Org Version]

U1 --> U2
U2 --> U3
U3 --> U4
U4 --> U5
U5 --> U6

end

A7 --> U1