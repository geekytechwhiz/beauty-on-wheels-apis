flowchart TB

%% =========================================================
%% USERS
%% =========================================================

PA[Platform Admin]
OA[Org Admin]
CM[Care Manager]
PAT[Patient Runtime]

%% =========================================================
%% UI LAYER
%% =========================================================

subgraph UI["Presentation Layer"]
WEB1[Master Template UI]
WEB2[Org Template UI]
WEB3[Package & Care Program UI]
WEB4[Patient Care Plan Runtime UI]
end

PA --> WEB1
OA --> WEB2
OA --> WEB3
CM --> WEB4

%% =========================================================
%% API LAYER
%% =========================================================

subgraph API["AWS API Layer"]
APIGW[Amazon API Gateway]
AUTH[Cognito + RBAC + ABAC]
end

WEB1 --> APIGW
WEB2 --> APIGW
WEB3 --> APIGW
WEB4 --> APIGW

APIGW --> AUTH

%% =========================================================
%% TEMPLATE DOMAIN
%% =========================================================

subgraph TEMPLATE["Template Service - Design Time Governance"]

direction TB

TMP1[Template Definition Service]
TMP2[Master Versioning Service]
TMP3[Org Template Derivation Service]
TMP4[Org Versioning Service]
TMP5[Template Linking Service]
TMP6[Metadata Allocation Engine]
TMP7[Compatibility Validation Engine]
TMP8[Scope & Manageability Engine]
TMP9[Diff & Upgrade Engine]
TMP10[Audit & Lineage Engine]

end

AUTH --> TEMPLATE

%% =========================================================
%% METADATA SERVICE
%% =========================================================

subgraph META["Metadata Registry Service"]

META1[Metadata Type Management]
META2[Metadata Value Management]
META3[Applicability Filtering]
META4[Metadata Versioning]
META5[Metadata Events]

end

%% =========================================================
%% MASTER TEMPLATE FLOW
%% =========================================================

subgraph MASTERFLOW["Master Template Lifecycle"]

M1[Create Master Template]
M2[Publish Master v1]
M3[Create Master v2]
M4[Publish Master v2]
M5[Master v1 becomes immutable]

M1 --> M2
M2 --> M3
M3 --> M4
M4 --> M5

end

TMP1 --> MASTERFLOW

%% =========================================================
%% ORG TEMPLATE FLOW
%% =========================================================

subgraph ORGFLOW["Org Template Derivation & Versioning"]

O1[Clone Published Master Template]
O2[Create Org Template Draft]
O3[Org Configures Scope & Metadata]
O4[Publish Org Template v1]
O5[Create Org Template v2 on Update]
O6[Latest Org Template becomes Active]
O7[Previous Org Version becomes Historical]

O1 --> O2
O2 --> O3
O3 --> O4
O4 --> O5
O5 --> O6
O6 --> O7

end

TMP3 --> ORGFLOW

%% =========================================================
%% IMPORTANT RULES
%% =========================================================

RULE1["Rule:
Master Template Updates NEVER modify existing Org Templates"]

RULE2["Rule:
Org Templates can ONLY be created by cloning Published Master Templates"]

RULE3["Rule:
Every modification creates a NEW version"]

RULE4["Rule:
Published versions are immutable"]

RULE5["Rule:
Latest Published Org Template becomes active"]

MASTERFLOW --> RULE1
ORGFLOW --> RULE2
ORGFLOW --> RULE3
ORGFLOW --> RULE4
ORGFLOW --> RULE5

%% =========================================================
%% METADATA DEPENDENCY
%% =========================================================

META --> TMP1
META --> TMP3
META --> TMP5
META --> TMP6
META --> TMP7

RULEMETA["All Templates are Metadata Driven"]

META --> RULEMETA

%% =========================================================
%% STORAGE
%% =========================================================

subgraph STORAGE["AWS Data Layer"]

DDB[(Amazon DynamoDB
Single Table Design)]

S3[(Amazon S3
Audit Snapshots)]

SEARCH[(OpenSearch
Search & Discovery)]

CACHE[(Redis Cache)]

end

TEMPLATE --> DDB
TMP10 --> S3
TEMPLATE --> SEARCH
TEMPLATE --> CACHE

%% =========================================================
%% EVENTING
%% =========================================================

subgraph EVENTS["Async Event Architecture"]

EB[Amazon EventBridge]

EV1[TemplatePublished]
EV2[OrgTemplatePublished]
EV3[MetadataChanged]
EV4[UpgradeDraftCreated]
EV5[CarePlanLinked]

end

TEMPLATE --> EB

EB --> EV1
EB --> EV2
EB --> EV3
EB --> EV4
EB --> EV5

%% =========================================================
%% PACKAGE LINKING
%% =========================================================

subgraph PACKAGE["Package & Program Layer"]

PKG1[Package Service]
PKG2[Service Catalog]
PKG3[Package-CarePlan Linking]
PKG4[Package Assignment]

end

WEB3 --> PKG1

PKG1 --> PKG2
PKG1 --> PKG3
PKG1 --> PKG4

%% =========================================================
%% CARE PLAN RUNTIME
%% =========================================================

subgraph RUNTIME["Patient Runtime Layer"]

RT1[Care Plan Runtime Service]
RT2[Patient Care Plan Instance]
RT3[Task Runtime]
RT4[OKR Runtime]
RT5[Symptom Runtime]
RT6[Threshold Runtime]
RT7[Alert Runtime]

end

%% =========================================================
%% RUNTIME CREATION FLOW
%% =========================================================

PKG4 -->|LinkedOrgCarePlanVersionID| RT1

RT1 --> RT2

RT2 --> RT3
RT2 --> RT4
RT2 --> RT5
RT2 --> RT6
RT2 --> RT7

%% =========================================================
%% TEMPLATE LINKING
%% =========================================================

subgraph LINKS["Template Linking Relationships"]

CP[Care Plan Template]

OKR[OKR Template]
TASK[Task Template]
SYM[Symptom Template]
THR[Threshold Template]
ALT[Alert Policy Template]

CP --> OKR
CP --> TASK
CP --> SYM

OKR --> TASK
OKR --> SYM

THR --> ALT

end

TMP5 --> LINKS

%% =========================================================
%% VERSION LINEAGE
%% =========================================================

subgraph LINEAGE["Version Lineage"]

MV1[Master v1]
MV2[Master v2]

OV1[Org v1 derived from Master v1]
OV2[Org v2 derived from Master v1]
OV3[Org Upgrade Draft from Master v2]

MV1 --> OV1
OV1 --> OV2
MV2 --> OV3

end

TMP9 --> LINEAGE

%% =========================================================
%% DESIGN TIME VS RUNTIME
%% =========================================================

subgraph GOVERNANCE["Critical Boundary"]

DT[Design Time Governance]
RT[Runtime Execution]

DT -.Strict Separation.-> RT

end

TEMPLATE --> DT
RUNTIME --> RT