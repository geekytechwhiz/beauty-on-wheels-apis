flowchart TB

%% =========================================
%% LAYER 1 — CHANNELS / ENTRY POINTS
%% =========================================

subgraph L1["Client & Event Sources"]
    USER["Users / Clients"]
    API["API Gateway"]
    EVENT_SRC["Event Sources\n(SQS / EventBridge)"]
    STREAM_SRC["DynamoDB Streams"]
end

USER --> API
EVENT_SRC --> LAMBDA
STREAM_SRC --> LAMBDA


%% =========================================
%% LAYER 2 — COMPUTE (LAMBDA)
%% =========================================

subgraph L2["Compute Layer (AWS Lambda)"]
    LAMBDA["Lambda Handlers\n(API / Event / Stream)"]
end

API --> LAMBDA


%% =========================================
%% LAYER 3 — EXECUTION (MIDDLEWARE)
%% =========================================

subgraph L3["Execution Layer (Middleware - Shared)"]
    MW["Logging • Tracing • Context • Validation"]
end

LAMBDA --> MW


%% =========================================
%% LAYER 4 — EVENT PLATFORM (CORE ENFORCEMENT)
%% =========================================

subgraph L4["Event Platform SDK (Shared Enforcement)"]
    SDK["Event Envelope\nSchema Validation\nIdempotency\nRetry Handling\nDLQ Routing"]
end

MW --> SDK


%% =========================================
%% LAYER 5 — BUSINESS LOGIC
%% =========================================

subgraph L5["Application Layer"]
    BL["Business Logic"]
end

SDK --> BL


%% =========================================
%% LAYER 6 — DATA & MESSAGING
%% =========================================

subgraph L6["Data & Messaging Layer"]
    DB["Primary Database\n(DynamoDB / RDS)"]
    BUS["Event Bus\n(SQS / EventBridge)"]
end

BL --> DB
BL --> BUS


%% =========================================
%% LAYER 7 — RELIABILITY (CROSS CUTTING)
%% =========================================

subgraph L7["Reliability Layer"]
    IDEMP["Idempotency Store\n(DynamoDB)"]
    RETRY["Retry Mechanism\n(AWS Managed)"]
    DLQ["Dead Letter Queue"]
end

SDK --> IDEMP
SDK --> RETRY
RETRY --> LAMBDA
RETRY --> DLQ


%% =========================================
%% LAYER 8 — OBSERVABILITY (CROSS CUTTING)
%% =========================================

subgraph L8["Observability Layer"]
    LOGS["CloudWatch Logs"]
    METRICS["Metrics / Monitoring"]
end

MW --> LOGS
BL --> LOGS
MW --> METRICS


%% =========================================
%% FEEDBACK LOOPS
%% =========================================

BUS --> EVENT_SRC