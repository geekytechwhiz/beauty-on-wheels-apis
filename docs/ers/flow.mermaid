flowchart TD

%% =========================
%% PRODUCERS
%% =========================
subgraph Producers["Microservices"]
    A1[Patient Service]
    A2[Billing Service]
end

%% =========================
%% PUBLISHER SDK
%% =========================
subgraph Publisher["Publisher Middleware SDK"]
    B1[Event Envelope Builder<br/>eventId, correlationId, causationId]
    B2[Correlation Injector]
    B3[Powertools Logger]
    B4["Powertools Tracer (X-Ray)"];
    B5["Metrics Publisher"];
    B6[Transport Adapter]
end

A1 --> B1
A2 --> B1
B1 --> B2 --> B3 --> B4 --> B5 --> B6

%% =========================
%% AWS EVENT LAYER
%% =========================
subgraph AWS_Transport["AWS Event Transport Layer"]

    SNS[SNS Topic]
    SQS[SQS Queue]
    EB[EventBridge Bus]

    SNS_DLQ[(SNS DLQ)]
    SQS_DLQ[(SQS DLQ)]
    EB_DLQ[(EventBridge DLQ)]

end

B6 --> SNS
B6 --> SQS
B6 --> EB

%% Retry & Failure Paths (Transport Level)
SNS -- Retry --> SNS
SNS -- Failure --> SNS_DLQ

SQS -- Retry --> SQS
SQS -- Failure --> SQS_DLQ

EB -- Retry --> EB
EB -- Failure --> EB_DLQ

%% =========================
%% CONSUMER SDK
%% =========================
subgraph Consumer["Consumer Middleware SDK (Lambda)"]

    C1[Transport Adapter Layer]
    C2[Event Normalizer]
    C3[Tracing & Correlation Propagation<br/>correlationId + X-Ray]
    C4[Powertools Logger + Metrics]
    C5[Schema Validator]

    C6[Idempotency Middleware<br/>DynamoDB Lock]
    C7[Context Enricher]

    C8[Business Handler]

    C9[Post Processor<br/>Publish Downstream Events]
    C10[Retry Controller]

end

SNS --> C1
SQS --> C1
EB --> C1

C1 --> C2 --> C3 --> C4 --> C5 --> C6 --> C7 --> C8 --> C9

%% =========================
%% DOMAIN LAYER
%% =========================
subgraph Domain["Domain Services"]
    D1[Business Logic]
    D2[State Management]
    D3[Versioning]
    D4[Audit Logs]
end

C8 --> D1 --> D2 --> D3 --> D4

%% =========================
%% STORAGE
%% =========================
subgraph Storage["DynamoDB"]
    DB1[(Domain Table)]
    DB2[(Idempotency Records<br/>eventId + status + ttl)]
end

D2 --> DB1
C6 --> DB2

%% =========================
%% FAILURE HANDLING (CONSUMER SIDE)
%% =========================
C5 -- Schema Failure --> DLQ_Global[(Consumer DLQ)]
C6 -- Duplicate --> C4
C8 -- Business Failure --> C10

C10 -- Retry --> C8
C10 -- Max Retry Exceeded --> DLQ_Global

%% =========================
%% OBSERVABILITY
%% =========================
subgraph Observability["Observability"]

    CW[CloudWatch Logs & Metrics]
    XRAY[X-Ray Tracing]
    ALARM[CloudWatch Alarms]

end

B3 --> CW
B4 --> XRAY
C4 --> CW
C3 --> XRAY
CW --> ALARM

%% =========================
%% TRACING PROPAGATION
%% =========================
B4 -. Trace Context .-> C3
B2 -. correlationId .-> C3