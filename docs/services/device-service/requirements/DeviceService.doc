<h3 local-id=3D"fb3e68f4-18a8-4c1f-8c2a-26e3f7bdc466" id=3D"DeviceService-5=
.DynamoDBAccessPatterns">5. DynamoDB Access Patterns</h3>
<div class=3D"table-wrap">
<table data-layout=3D"default" data-local-id=3D"c48f3e0d-f89f-46d5-9c8a-1fc=
a9f8a9e83" class=3D"confluenceTable">
<tbody>
<tr ac:local-id=3D"673baabc-fc28-46fa-b59a-6f9b7bf90cfc">
<th data-local-id=3D"0ac0fe0b-46e0-4e13-92b9-da68595e0441" class=3D"conflue=
nceTh">
<p local-id=3D"384bba6e-cd6f-469f-8b12-06fa96a2ac5c"><strong>Operation</str=
ong></p></th>
