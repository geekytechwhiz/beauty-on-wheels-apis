flowchart LR
  subgraph handler["Service Handler"]
    A[Canonical domain object]
  end
  subgraph middleware["withApiHandler"]
    B[transformToFhirResponse]
    C["successResponse(data + fhir sibling)"]
  end
  subgraph fhirLib["@api-hub/fhir"]
    D[ResourceDiscoveryService]
    E[FhirTransformationService]
    F[GenericMapper + JSON mappings]
    G[BundleBuilder collection]
  end
  A --> B
  B --> D --> E --> F --> G
  B --> C
