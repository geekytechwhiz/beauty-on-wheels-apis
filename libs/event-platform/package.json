    "@api-hub/observability": "workspace:*",
    "@api-hub/utils": "workspace:*",
    "@aws-sdk/client-eventbridge": "^3.958.0",
    "@aws-sdk/client-sns": "^3.958.0",
    "@aws-sdk/client-sqs": "^3.1001.0",
    "@smithy/node-http-handler": "^4.0.0",
    "tslib": "^2.3.0",
    "zod": "^4.2.1"
