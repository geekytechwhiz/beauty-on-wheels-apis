{
  "name": "event-platform",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/event-platform/src",
  "projectType": "library",
  "tags": ["type:lib", "allowed-for-app"],
  "// targets": "to see all targets run: nx show project logger --web",
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "dependsOn": [],
      "options": {
        "jestConfig": "libs/event-platform/jest.config.cts",
        "passWithNoTests": false
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "build": {
      "executor": "@nx/vite:build",
      "cache": true,
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/libs/event-platform"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    }
  }
}
