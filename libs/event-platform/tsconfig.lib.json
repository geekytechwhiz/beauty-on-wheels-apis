{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": false,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [
      "node"
    ],
    "declaration": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts"
  ],
  "references": [
    {
      "path": "../utils/tsconfig.lib.json"
    },
    {
      "path": "../middleware/tsconfig.lib.json"
    },
    {
      "path": "../logger/tsconfig.lib.json"
    },
    {
      "path": "../observability/tsconfig.lib.json"
    }
  ],
  "exclude": [
    "jest.config.ts",
    "jest.config.cts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ]
}
