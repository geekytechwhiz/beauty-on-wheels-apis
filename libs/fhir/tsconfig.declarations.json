{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "src",
    "outDir": "../../dist/libs/fhir",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "composite": false,
    "noEmit": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "src/generated/**/*.json",
    "src/mappings/**/*.json"
  ],
  "exclude": ["src/**/*.spec.ts", "src/tests/**"]
}
