{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "forceConsistentCasingInFileNames": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/tests/**",
    "src/package/**"
  ],
  "references": [
    {
      "path": "../utils/tsconfig.lib.json"
    },
    {
      "path": "../terminology/tsconfig.lib.json"
    },
    {
      "path": "../observability/tsconfig.lib.json"
    },
    {
      "path": "../middleware/tsconfig.lib.json"
    }
  ]
}
