{
  "name": "@myvitalrx/observability",
  "version": "2.6.0",
  "description": "Enterprise observability library for logging, metrics, and context propagation",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "jest",
    "lint": "eslint .",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.x",
    "@aws-lambda-powertools/metrics": "^2.x"
  },
  "devDependencies": {
    "@types/jest": "^29.x",
    "jest": "^29.x",
    "tsup": "^8.x",
    "typescript": "^5.x"
  },
  "peerDependencies": {
    "aws-lambda": "^1.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
