{
  "config": {
    "ruleScope": "GLOBAL",
    "description": "Cross-cutting rules. Merge with template rules at evaluate time when your service wires them; not loaded automatically by template-service execute today."
  },
  "rules": [
    {
      "id": "RULE_LINK_001",
      "name": "CarePlan must link OKR",
      "priority": 1,
      "enabled": true,
      "conditions": {
        "all": [
          { "fact": "templateType", "operator": "equal", "value": "CARE_PLAN" }
        ]
      },
      "actions": [
        {
          "type": "TRIGGER_EVENT",
          "target": "LINK_REQUIRED",
          "value": { "requiredTemplate": "OKR" }
        }
      ],
      "metadata": {
        "module": "global",
        "version": "v1",
        "createdFrom": "excel"
      }
    },
    {
      "id": "RULE_LINK_002",
      "name": "OKR must link Task",
      "priority": 2,
      "enabled": true,
      "conditions": {
        "all": [
          { "fact": "templateType", "operator": "equal", "value": "OKR" }
        ]
      },
      "actions": [
        {
          "type": "TRIGGER_EVENT",
          "target": "LINK_REQUIRED",
          "value": { "requiredTemplate": "TASK" }
        }
      ],
      "metadata": {
        "module": "global",
        "version": "v1",
        "createdFrom": "excel"
      }
    },
    {
      "id": "RULE_STATUS_001",
      "name": "Allow Saved to In Review",
      "priority": 3,
      "enabled": true,
      "conditions": {
        "all": [
          { "fact": "fromStatus", "operator": "equal", "value": "SAVED" }
        ]
      },
      "actions": [
        {
          "type": "SET",
          "target": "allowedNextStatus",
          "value": ["IN_REVIEW"]
        }
      ],
      "metadata": {
        "module": "global",
        "version": "v1",
        "createdFrom": "excel"
      }
    },
    {
      "id": "RULE_STATUS_002",
      "name": "Allow In Review to Published",
      "priority": 4,
      "enabled": true,
      "conditions": {
        "all": [
          { "fact": "fromStatus", "operator": "equal", "value": "IN_REVIEW" }
        ]
      },
      "actions": [
        {
          "type": "SET",
          "target": "allowedNextStatus",
          "value": ["PUBLISHED"]
        }
      ],
      "metadata": {
        "module": "global",
        "version": "v1",
        "createdFrom": "excel"
      }
    },
    {
      "id": "RULE_META_001",
      "name": "TemplateType is required",
      "priority": 5,
      "enabled": true,
      "conditions": {
        "all": [
          { "fact": "templateType", "operator": "notEqual", "value": null }
        ]
      },
      "actions": [
        {
          "type": "SET",
          "target": "validation.templateType",
          "value": "VALID"
        }
      ],
      "metadata": {
        "module": "global",
        "version": "v1",
        "createdFrom": "excel"
      }
    }
  ],
  "actions": []
}
