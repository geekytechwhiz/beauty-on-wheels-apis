{
  "config": {
    "templateId": "care-plan-basic",
    "version": "v1"
  },
  "rules": [
    {
      "id": "RULE_TEMPLATE_001",
      "name": "Default sections allowed",
      "priority": 10,
      "enabled": true,
      "conditions": {
        "all": [
          { "fact": "templateId", "operator": "equal", "value": "care-plan-basic" }
        ]
      },
      "actions": [
        {
          "type": "SET",
          "target": "allowedSections",
          "value": ["GOALS", "TASKS", "METRICS"]
        }
      ],
      "metadata": {
        "module": "template",
        "version": "v1",
        "templateId": "care-plan-basic",
        "createdFrom": "excel"
      }
    },
    {
      "id": "RULE_TEMPLATE_002",
      "name": "Metadata mode fixed",
      "priority": 11,
      "enabled": true,
      "conditions": {
        "all": [
          { "fact": "templateId", "operator": "equal", "value": "care-plan-basic" }
        ]
      },
      "actions": [
        {
          "type": "SET",
          "target": "metadataMode",
          "value": "FIXED"
        }
      ],
      "metadata": {
        "module": "template",
        "version": "v1",
        "templateId": "care-plan-basic",
        "createdFrom": "excel"
      }
    },
    {
      "id": "RULE_TEMPLATE_003",
      "name": "Enforce master structure",
      "priority": 12,
      "enabled": true,
      "conditions": {
        "all": [
          { "fact": "templateId", "operator": "equal", "value": "care-plan-basic" }
        ]
      },
      "actions": [
        {
          "type": "SET",
          "target": "structureMode",
          "value": "MASTER_ENFORCED"
        }
      ],
      "metadata": {
        "module": "template",
        "version": "v1",
        "templateId": "care-plan-basic",
        "createdFrom": "excel"
      }
    }
  ],
  "actions": []
}
