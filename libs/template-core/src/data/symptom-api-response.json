      "props": {
        "addButtonLabel": "Add Question",
        "commonFields": [
          {
            "name": "questionText",
            "type": "text",
            "label": "Question Text",
            "required": true,
            "placeholder": "Enter your question...",
            "validation": {
              "required": {
                "value": true,
                "message": "Question text is required"
              }
            }
          },
          {
            "name": "questionCode",
            "type": "text",
            "label": "Question Code",
            "placeholder": "e.g. HTN_HEADACHE_YN",
            "required": true,
            "helperText": "Convention: <DOMAIN>_<QUESTION>[_<TYPE>]",
            "validation": {
              "required": {
                "value": true,
                "message": "Question code is required"
              },
              "pattern": {
                "value": "^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$",
                "message": "Use uppercase letters, numbers, and underscores (e.g. HTN_HEADACHE_YN)"
              }
            }
          }
        ],
