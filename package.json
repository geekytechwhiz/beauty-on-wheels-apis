    "@aws-sdk/client-lambda": "^3.971.0",
    "@aws-sdk/client-s3": "3.1054.0",
    "@aws-sdk/client-secrets-manager": "^3.966.0",
    "@aws-sdk/client-sns": "^3.958.0",
    "@aws-sdk/client-sqs": "^3.1001.0",
    "@aws-sdk/lib-dynamodb": "^3.958.0",
    "@aws-sdk/s3-request-presigner": "3.1054.0",
    "@aws-sdk/util-dynamodb": "^3.958.0",
    "@ahryman40k/ts-fhir-types": "^4.0.39",
    "@babel/parser": "^7.29.2",
    "@babel/traverse": "^7.29.0",
    "@middy/http-cors": "^7.0.2",
    "@types/fs-extra": "^11.0.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/object-path": "^0.11.4",
    "@types/pdfkit": "^0.17.4",
    "@vitejs/plugin-react": "^4.7.0",
    "ajv": "^8.17.1",
    "aws-lambda": "^1.0.7",
    "aws-xray-sdk-core": "^3.12.0",
    "axios": "^1.6.0",
    "axios-retry": "^4.5.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "fhir": "^4.12.0",
    "fhir-package-loader": "^2.2.4",
    "fhirpath": "^4.10.1",
    "fs-extra": "^11.3.5",
    "get-stream": "^9.0.1",
    "glob": "^13.0.0",
    "handlebars": "^4.7.9",
    "join": "^3.0.0",
    "js-yaml": "^4.1.1",
    "jsonata": "^2.2.1",
    "jsonwebtoken": "^9.0.3",
    "jwk-to-pem": "^2.0.5",
    "libphonenumber-js": "^1.12.39",
    "object-path": "^0.11.8",
    "pdfkit": "^0.17.2",
    "serverless-auto-swagger": "^3.1.0",
    "serverless-dotenv-plugin": "^6.0.0",
    "serverless-esbuild": "^1.57.0",
    "serverless-offline": "^13.9.0",
    "serverless-openapi-documentation": "^0.4.0",
    "ts-morph": "^28.0.0",
    "ulid": "^3.0.2",
    "winston": "^3.19.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@jest/globals": "^30.0.2",
    "@nx/esbuild": "22.3.3",
    "@nx/eslint": "22.3.3",
    "@nx/eslint-plugin": "22.3.3",
    "@nx/jest": "22.3.3",
    "@nx/js": "22.3.3",
    "@nx/node": "22.3.3",
    "@nx/vite": "22.3.3",
    "@nx/web": "22.3.3",
    "@nx/webpack": "22.3.3",
    "@nx/workspace": "22.3.3",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.7",
    "@svgr/webpack": "^8.0.1",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@swc/jest": "~0.2.38",
    "@types/aws-lambda": "^8.10.159",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/luxon": "^3.7.1",
    "@types/node": "20.19.9",
    "@types/winston": "^2.4.4",
    "@vitest/ui": "^4.0.0",
    "babel-jest": "^30.0.2",
    "esbuild": "^0.19.2",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "husky": "^9.1.7",
    "jest": "^30.0.2",
    "jest-environment-node": "^30.0.2",
    "jest-util": "^30.0.2",
    "jiti": "2.4.2",
    "jsonc-eslint-parser": "^2.1.0",
    "lint-staged": "16.1.2",
    "nx": "22.3.3",
    "prettier": "~3.6.2",
    "react-refresh": "^0.10.0",
    "serverless": "^3.40.0",
    "serverless-openapi-documenter": "^0.1.1",
    "serverless-plugin-warmup": "^8.4.1",
    "ts-jest": "^29.4.0",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "verdaccio": "^6.0.5",
    "vite": "^7.0.0",
    "vite-plugin-dts": "~4.5.0",
    "vitest": "^4.0.0",
    "webpack-cli": "^5.1.4"
  },
  "pnpm": {
    "overrides": {
      "@smithy/types": "4.14.2"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "node tools/lint-staged.js"
    ]
  },
  "nx": {
    "includedScripts": [],
    "targets": {}
  }
}
