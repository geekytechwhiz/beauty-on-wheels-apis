{
  "name": "@api-hub/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "cleanup:eslint": "node tools/scripts/cleanup-eslint.js",
    "user-service:offline": "cd apps/user-service && npx nodemon --watch src --ext ts,js,yml,json --exec \"serverless offline --stage dev --aws-profile ci-user\"",
    "deploy:fhir-gateway": "cd services/fhir-gateway && serverless deploy",
    "fhir-gateway:offline": "cd services/fhir-gateway && serverless offline",
    "fhir-gateway:offline:dev": "cd services/fhir-gateway && FHIR_GATEWAY_LOCAL_DEV=true serverless offline",
    "fhir-gateway:offline:dev:watch": "cd services/fhir-gateway && pnpm run offline:dev:watch",
    "authorizer-service:offline": "cd services/authorizer-service && serverless offline",
    "build:all": "nx run-many --target=build --all --parallel=25 --batch",
    "alert-service:offline": "cd apps/alert-service && npx nodemon --watch src --ext ts,js,yml,json --exec \"serverless offline --stage dev\"",
    "template-service:offline": "cd apps/template-service && npx nodemon --watch src --ext ts,js,yml,json --exec \"serverless offline --stage dev\"",
    "aggregator:backend:dev": "pnpm --filter @api-hub/api-aggregator-backend dev",
    "aggregator:backend:build": "pnpm --filter @api-hub/api-aggregator-backend build",
    "aggregator:backend:start": "pnpm --filter @api-hub/api-aggregator-backend start",
    "aggregator:frontend:dev": "pnpm --filter @api-hub/api-aggregator-frontend dev",
    "aggregator:frontend:dev:registry": "pnpm --filter @api-hub/api-aggregator-frontend dev:registry",
    "aggregator:frontend:build": "pnpm --filter @api-hub/api-aggregator-frontend build",
    "test:all": "nx run-many --target=test --all --parallel=10 --batch",
    "lint:all": "nx run-many --target=lint --all --parallel=25 --batch",
    "lint:affected": "nx affected --target=lint --parallel=10 --batch",
    "build:affected": "nx affected --target=build --parallel=10",
    "test:affected": "nx affected --target=test --parallel=10 --batch",
    "build:no-cache": "nx build --skip-nx-cache",
    "build:verbose": "nx build --verbose",
    "graph": "nx graph",
    "graph:affected": "nx graph --affected",
    "show:projects": "nx show projects",
    "show:app": "nx show project ",
    "deploy": "nx run :deploy",
    "format": "nx format:write",
    "reset": "nx reset",
    "profile": "NX_PROFILE=profile.json nx build ",
    "migrate:handlers-v1": "ts-node --project tools/handler-migrartion/tsconfig.json tools/handler-migrartion/migrate-handlers-to-v1.ts",
    "migrate:handlers-v1:metadata-registry": "ts-node --project tools/handler-migrartion/tsconfig.json tools/handler-migrartion/migrate-handlers-to-v1.ts metadata-registry-service",
    "migrate:handlers-v1:organization": "ts-node --project tools/handler-migrartion/tsconfig.json tools/handler-migrartion/migrate-handlers-to-v1.ts organization-service",
    "fix:imports": "ts-node --project tools/file-import/fix-imports.tsconfig.json tools/file-import/fix-imports.ts",
    "update:version": "ts-node --project tools/update-version/tsconfig.json tools/update-version/update-version.ts",
    "fix:imports:light": "FIX_IMPORTS_SKIP_CLEAN=1 FIX_IMPORTS_SKIP_BUILD=1 ts-node --project tools/file-import/fix-imports.tsconfig.json tools/file-import/fix-imports.ts",
    "fix:imports:sh": "sh tools/file-import/fix-imports.sh",
    "fhir:generate-resources": "ts-node --project libs/fhir/scripts/tsconfig.json libs/fhir/scripts/generate-resources.ts",
    "fhir:generate-mappings": "ts-node --project libs/fhir/scripts/tsconfig.json libs/fhir/scripts/generate-mappings.ts",
    "fhir:generate-scopes": "ts-node --project libs/fhir/scripts/tsconfig.json libs/fhir/scripts/generate-scopes.ts",
    "fhir:generate-config": "ts-node --project libs/fhir/scripts/tsconfig.json libs/fhir/scripts/generate-config.ts",
    "fhir:test": "ts-node --project libs/fhir/scripts/tsconfig.json libs/fhir/src/test.ts",
    "lint": "nx run-many --target=lint --all --parallel=10",
    "lint:fix": "nx run-many --target=lint --all --parallel=25 --fix",
    "prepare": "husky",
    "build:platform-tools": "nx build observability event-platform middleware platform-tools",
    "publish:platform-tools": "nx build observability event-platform middleware platform-tools && cd packages/platform-tools && export NPM_TOKEN=\"$(grep '^NPM_TOKEN=' ../../.env | cut -d= -f2- | tr -d '\\r\\n\\\"')\" && npm publish --access public --userconfig=../../.npmrc"
  },
  "private": true,
  "dependencies": {
    "@aws-lambda-powertools/commons": "^2.33.0",
    "@aws-lambda-powertools/logger": "^2.33.0",
    "@aws-lambda-powertools/metrics": "^2.33.0",
    "@aws-lambda-powertools/tracer": "^2.33.0",
    "@aws-sdk/client-apigatewaymanagementapi": "^3.958.0",
