    "@aws-sdk/client-secrets-manager": "^3.966.0",
    "@aws-sdk/client-sns": "^3.958.0",
    "@aws-sdk/client-sqs": "^3.1001.0",
    "@aws-sdk/lib-dynamodb": "^3.958.0",
    "@aws-sdk/util-dynamodb": "^3.958.0",
    "@babel/parser": "^7.29.2",
