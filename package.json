    "jsonwebtoken": "^9.0.3",
    "jwk-to-pem": "^2.0.5",
    "libphonenumber-js": "^1.12.39",
    "pdfkit": "^0.17.2",
    "serverless-auto-swagger": "^3.1.0",
    "serverless-dotenv-plugin": "^6.0.0",
    "serverless-esbuild": "^1.57.0",
    "serverless-offline": "^13.9.0",
