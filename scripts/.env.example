# Metadata Registry HTTP seed — copy to scripts/.env and adjust
#
# Prereq (repo root): pnpm metadata-registry-service:offline
# Then: pnpm seed:metadata

# Local serverless offline — must include stage prefix (/dev)
BASE_URL=http://localhost:3000/dev

# Excel source (default: helpers/metadata/Complete metadata.xlsx)
# METADATA_EXCEL_PATH=helpers/metadata/Complete metadata.xlsx

# Optional Bearer token when authorizer is enabled
# AUTH_TOKEN=

# Validate payloads without HTTP writes
# DRY_RUN=true

# Draft only (skip publish); default is auto-publish after each draft
# AUTO_PUBLISH=false

# Must be true when publish impact preview requires confirmation (default true)
# CONFIRMATION_ACKNOWLEDGED=true

# Parallel value creates (phase 2)
CONCURRENCY=5

RETRY_MAX=3
RETRY_DELAY_MS=500

# Entity paths — action query param is appended by the seed client
# POST {typePath}?action=draft then ?action=publish
METADATA_TYPE_PATH=/metadata/type
METADATA_VALUE_PATH=/metadata/value

# Treat 409 / version mismatch as success on re-seed
TREAT_CONFLICT_AS_SUCCESS=true

LOG_LEVEL=info
