# Metadata Registry HTTP seed — copy to scripts/metadata-registry-seed/.env and adjust
#
# Prereq (repo root): pnpm metadata-registry-service:offline
# Then: pnpm seed:metadata
# After seed completes: pnpm backfill:metadata-type-modules
# Scoped seed (selected types + values only):
# METADATA_TYPE_CODES=Department,Specialty
# Type-only seed (no values): pnpm seed:metadata-types with METADATA_TYPE_CODES
# Backfill one type's modules: METADATA_TYPE_CODE=Country pnpm backfill:metadata-type-modules

# Local serverless offline — must include stage prefix (/dev)
BASE_URL=http://localhost:3000/dev

# Excel source (default: helpers/metadata/Complete metadata (1).xlsx)
# METADATA_EXCEL_PATH=helpers/metadata/Complete metadata (1).xlsx

# Optional JWT for createdBy/lastModifiedBy (never commit real tokens).
# When set, seed sends Authorization: Bearer <token>; registry stores custom:userID | userId | sub from the JWT.
# AUTH_TOKEN takes precedence over SEED_ACTOR_USER_ID.
# AUTH_TOKEN=eyJhbGciOi...

# Script-only actor (no expiring JWT): platform userId for bulk seed / CI/CD.
# Used when AUTH_TOKEN is unset. Seed builds an unsigned Bearer with custom:userID (seed tooling only).
# SEED_ACTOR_USER_ID=88a9a6e052092188660a404a303ca34c992caabfccfc184ca2121fcac2d84e7f
# Validate payloads without HTTP writes
# DRY_RUN=true

# Draft only (skip publish); default is auto-publish after each draft
# AUTO_PUBLISH=false

# Must be true when publish impact preview requires confirmation (default true)
# CONFIRMATION_ACKNOWLEDGED=true

# Parallel value creates (phase 2 simple values + phase 3 rich values e.g. State/City)
# Start at 5; try 10–15 against dev if stable. Lower if you see 429/throttling.
CONCURRENCY=5

RETRY_MAX=3
RETRY_DELAY_MS=500

# Entity paths — action query param is appended by the seed client
# POST {typePath}?action=draft then ?action=publish
METADATA_TYPE_PATH=/metadata/type
METADATA_VALUE_PATH=/metadata/value

# Treat 409 / version mismatch as success on re-seed
TREAT_CONFLICT_AS_SUCCESS=true

# Seed run reports (JSON + CSV) — default: scripts/metadata-registry-seed/reports/seed-report-<timestamp>.{json,csv}
# SEED_REPORT_PATH=scripts/metadata-registry-seed/reports
# SEED_REPORT_PATH=scripts/metadata-registry-seed/reports/my-stg-run.json
# SEED_REPORT_CSV=false

# --- CI/CD (CodeBuild) — see apps/metadata-registry-service/ci/SEED-CI.md ---
# RUN_METADATA_SEED=true
# METADATA_CATALOG_S3_BUCKET=nvstg-metadata-catalog
# METADATA_CATALOG_S3_KEY=metadata/Complete-metadata.xlsx
# METADATA_EXCEL_PATH=/tmp/Complete-metadata.xlsx
# ALLOW_FULL_METADATA_SEED=true
# CONFIRM_METADATA_SEED=true
# SEED_ACTOR_USER_ID=<platform-user-id>   # set in CodeBuild env — do not commit real ids
LOG_LEVEL=info
