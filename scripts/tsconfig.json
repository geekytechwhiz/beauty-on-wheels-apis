{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "types": ["node"],
    "rootDir": "..",
    "outDir": "../dist/metadata-seed"
  },
  "include": ["../helpers/**/*.ts", "./**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
