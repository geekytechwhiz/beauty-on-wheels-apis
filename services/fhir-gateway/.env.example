# Copy to .env; serverless-dotenv-plugin loads it when you run serverless offline.
# Base URL of your user/patient API (no trailing slash)
USER_SERVICE_URL=https://v1w4b4vunl.execute-api.us-east-1.amazonaws.com/dev
# Path + query for patient by id (default: get-user-details?userID={id})
USER_SERVICE_PATIENT_PATH=get-user-details?userID={id}
# Optional: force adapter (user-service | stub). Default: user-service when URL set
# PATIENT_SOURCE=user-service

# Local dev: use stub auth + skip tenant check (any Bearer token accepted)
FHIR_GATEWAY_LOCAL_DEV=true
