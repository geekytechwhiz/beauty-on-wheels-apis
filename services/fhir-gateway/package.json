{
  "name": "@api-hub/fhir-gateway",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "deploy": "serverless deploy",
    "offline": "serverless offline",
    "offline:dev": "FHIR_GATEWAY_LOCAL_DEV=true serverless offline",
    "offline:dev:watch": "nodemon --watch src --watch serverless.yml --ext ts,js,yml,json --exec \"FHIR_GATEWAY_LOCAL_DEV=true serverless offline\"",
    "package": "serverless package"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "serverless": "^3.40.0",
    "serverless-dotenv-plugin": "^6.0.0",
    "serverless-esbuild": "^1.57.0",
    "serverless-offline": "^13.9.0"
  }
}
