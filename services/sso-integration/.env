# =============================================================================
# SSO Integration Service Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env files to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# General Service Configuration
# -----------------------------------------------------------------------------
NODE_ENV=dev
SERVICE_NAME=sso-integration
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# AWS Cognito Configuration
# -----------------------------------------------------------------------------
# The Cognito User Pool ID where SSO users will be authenticated
COGNITO_USER_POOL_ID=us-east-1_AK1HTxdlX

# The Cognito App Client ID (must have ADMIN_USER_PASSWORD_AUTH enabled)
COGNITO_CLIENT_ID=your-cognito-client-id

# -----------------------------------------------------------------------------
# HMS (Health Management System) Configuration
# -----------------------------------------------------------------------------
# Base URL for HMS API (no trailing slash)
HMS_BASE_URL=https://hms.example.com

# API key for HMS authentication
HMS_API_KEY=your-hms-api-key

# Timeout for HMS API calls in milliseconds (default: 5000)
HMS_TIMEOUT_MS=5000

# -----------------------------------------------------------------------------
# User Service Configuration
# -----------------------------------------------------------------------------
# Internal API endpoint for user-service
USER_SERVICE_BASE_URL=https://api.internal.example.com/user-service

# Internal API key for user-service authentication
USER_SERVICE_INTERNAL_API_KEY=your-user-service-api-key

# -----------------------------------------------------------------------------
# Role Service Configuration
# -----------------------------------------------------------------------------
# Internal API endpoint for role-service
ROLE_SERVICE_BASE_URL=https://api.internal.example.com/role-service

# Internal API key for role-service authentication
ROLE_SERVICE_INTERNAL_API_KEY=your-role-service-api-key

# -----------------------------------------------------------------------------
# Rate Limiting Configuration
# -----------------------------------------------------------------------------
# Time window for rate limiting in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Maximum requests per IP within the rate limit window (default: 100)
RATE_LIMIT_MAX_REQUESTS=100
