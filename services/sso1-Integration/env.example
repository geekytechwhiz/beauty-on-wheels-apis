# ─────────────────────────────────────────────────────────────────────────────
# AWS Serverless SSO — Environment Variables
# Copy this file to .env and fill in your values before deploying.
# ─────────────────────────────────────────────────────────────────────────────

# ── AWS Region ────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1

# ── Cognito (auto-injected by CloudFormation after first deploy; fill in manually
#    for local development with `serverless offline`) ─────────────────────────
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_DOMAIN=aws-serverless-sso-dev-auth-domain

# ── OAuth2 Redirect URLs ───────────────────────────────────────────────────────
# Local development
CALLBACK_URL=http://localhost:3001/dev/auth/callback
LOGOUT_REDIRECT_URL=http://localhost:3001

# Production example
# CALLBACK_URL=https://yourdomain.com/auth/callback
# LOGOUT_REDIRECT_URL=https://yourdomain.com

# ── Deployment Stage ──────────────────────────────────────────────────────────
STAGE=dev
