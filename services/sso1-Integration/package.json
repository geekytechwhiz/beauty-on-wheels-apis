{
  "name": "aws-serverless-sso",
  "version": "1.0.0",
  "description": "AWS Serverless Single Sign-On using Amazon Cognito, Lambda, and API Gateway with Node.js & TypeScript",
  "scripts": {
    "build": "tsc --noEmit",
    "deploy": "serverless deploy --stage dev",
    "deploy:prod": "serverless deploy --stage prod",
    "remove": "serverless remove --stage dev",
    "offline": "serverless offline start --httpPort 3001",
    "logs:login": "serverless logs -f login -t",
    "logs:callback": "serverless logs -f callback -t",
    "logs:profile": "serverless logs -f getProfile -t"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "3.993.0",
    "aws-jwt-verify": "5.1.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.143",
    "@types/node": "^20.14.0",
    "esbuild": "0.27.3",
    "serverless": "^3.38.0",
    "serverless-esbuild": "^1.52.1",
    "serverless-offline": "^13.6.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
