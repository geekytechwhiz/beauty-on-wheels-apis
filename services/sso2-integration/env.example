# ─────────────────────────────────────────────────────────────────────────────
# SSO MyVitalRx — Environment Variables
# Copy this file to .env and fill in your values
# .env is loaded automatically by serverless (useDotenv: true in serverless.yml)
# ─────────────────────────────────────────────────────────────────────────────

# ── AWS Credentials (required for DynamoDB access) ────────────────────────────
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID_HERE
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY_HERE
AWS_REGION=us-east-1

# ── App Environment ───────────────────────────────────────────────────────────
ENV=dev

# ── JWT Settings ──────────────────────────────────────────────────────────────
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRY=3600
REFRESH_TOKEN_EXPIRY=86400

# ── Token TTL ─────────────────────────────────────────────────────────────────
LAUNCH_TOKEN_TTL=300

# ── App URLs ──────────────────────────────────────────────────────────────────
MYVITALRX_BASE_URL=https://app.myvitalrx.com

# ── DynamoDB Table Names ──────────────────────────────────────────────────────
LAUNCH_TOKENS_TABLE=sso-launch-tokens-dev
SESSIONS_TABLE=sso-sessions-dev
HMS_CLIENTS_TABLE=sso-hms-clients-dev
