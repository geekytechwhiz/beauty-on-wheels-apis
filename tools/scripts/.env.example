# Metadata Registry HTTP seed — copy to tools/scripts/.env and adjust
#
# Prereq (repo root): pnpm metadata-registry-service:offline
# Then: pnpm seed:metadata
# After seed completes: pnpm backfill:metadata-type-modules
# Scoped seed (selected types + values only):
# METADATA_TYPE_CODES=Department,Specialty
# Type-only seed (no values): pnpm seed:metadata-types with METADATA_TYPE_CODES
# Backfill one type's modules: METADATA_TYPE_CODE=Country pnpm backfill:metadata-type-modules

# Local serverless offline — must include stage prefix (/dev)
BASE_URL=http://localhost:3000/dev

# Excel source (default: helpers/metadata/Complete metadata (1).xlsx)
# METADATA_EXCEL_PATH=helpers/metadata/Complete metadata (1).xlsx

# Optional dev JWT for createdBy/lastModifiedBy attribution (never commit real tokens).
# Loaded from tools/scripts/.env or process.env. When set, seed sends Authorization: Bearer <token>;
# the registry stores custom:userID | userId | sub from the JWT (not createdBy in body).
# GET/list resolves display name from USER_TABLE; omit token to keep actor "system".
# AUTH_TOKEN=eyJhbGciOi...

# Validate payloads without HTTP writes
# DRY_RUN=true

# Draft only (skip publish); default is auto-publish after each draft
# AUTO_PUBLISH=false

# Must be true when publish impact preview requires confirmation (default true)
# CONFIRMATION_ACKNOWLEDGED=true

# Parallel value creates (phase 2 simple values + phase 3 rich values e.g. State/City)
# Start at 5; try 10–15 against dev if stable. Lower if you see 429/throttling.
CONCURRENCY=5

RETRY_MAX=3
RETRY_DELAY_MS=500

# Entity paths — action query param is appended by the seed client
# POST {typePath}?action=draft then ?action=publish
METADATA_TYPE_PATH=/metadata/type
METADATA_VALUE_PATH=/metadata/value

# Treat 409 / version mismatch as success on re-seed
TREAT_CONFLICT_AS_SUCCESS=true

LOG_LEVEL=info
