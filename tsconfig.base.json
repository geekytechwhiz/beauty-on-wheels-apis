{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "baseUrl": ".",
    "target": "es2022",
    "customConditions": ["@api-hub/source"],
    "paths": {
      "@api-hub/event-platform": ["libs/event-platform/src/index.ts"],
      "@api-hub/observability": ["libs/observability/src/index.ts"],
      "@api-hub/utils": ["libs/utils/src/index.ts"],
      "@api-hub/authentication-core": ["libs/authentication-core/src/index.ts"],
      "@api-hub/middleware": ["libs/middleware/src/index.ts"],
      "@myvitalrx/platform-tools/middleware": [
        "packages/platform-tools/src/middleware.ts"
      ],
      "@myvitalrx/platform-tools/observability": [
        "packages/platform-tools/src/observability.ts"
      ],
      "@myvitalrx/platform-tools/event-platform": [
        "packages/platform-tools/src/event-platform.ts"
      ],
      "@api-hub/booking-core": ["libs/booking-core/src/index.ts"]
    }
  }
}
